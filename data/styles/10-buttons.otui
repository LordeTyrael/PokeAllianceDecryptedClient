Button < UIButton
  font: verdana-11px-antialised
  color: #dfdfdfff
  size: 106 23
  text-offset: 0 1
  image-source: /images/ui/button
  image-color: #dfdfdf
  image-clip: 0 0 22 23
  image-border: 3
  padding: 5 10 5 10
  opacity: 1.0
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 23 22 23

  $pressed:
    image-clip: 0 46 22 23
    text-offset: 1 1

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

TabButton < UIButton
  size: 20 20
  image-source: /images/ui/panels/tabbutton_rounded
  image-color: #dfdfdf
  image-clip: 0 0 20 20
  image-border: 3
  text-offset: 0 1
  icon-color: #dfdfdf
  color: #dfdfdf
  change-cursor-image: true
  cursor: pointer

  $hover !on:
    image-clip: 0 20 20 20
    color: #dfdfdf

  $disabled:
    image-color: #dfdfdf66
    icon-color: #dfdfdf
    change-cursor-image: false

  $on:
    image-clip: 0 40 20 20
    color: #dfdfdf

ChangeHeldButton < UIButton
  size: 20 20
  image-source: /images/ui/panels/tabbutton_on
  image-color: #dfdfdf
  image-clip: 0 0 105 30
  image-border: 3
  text-offset: 0 1
  icon-color: #dfdfdf
  color: #dfdfdf
  change-cursor-image: true
  cursor: pointer

  $hover !on:
    image-clip: 0 0 105 30
    color: #24fc03

  $disabled:
    image-color: #dfdfdf66
    icon-color: #dfdfdf
    change-cursor-image: false

  $on:
    image-clip: 0 40 20 20
    color: #dfdfdf

AddonsButton < UICheckBox
  image-source: /images/ui/panels/tabbutton_on
  image-color: #dfdfdf
  text-align: center
  icon-color: #dfdfdf
  color: #dfdfdf
  change-cursor-image: true
  cursor: pointer
  text-align: center

  --$hover !on:
  --  color: #03b1fc

  $disabled:
    image-color: #dfdfdf66
    icon-color: #dfdfdf
    change-cursor-image: false

  $on:
    color: #dfdfdf

TabButtonPrev < UIButton
  height: 45
  width: 25
  image-source: /images/ui/panels/buttons/tabbutton_left  
  background-color: alpha
  --image-color: #dfdfdf
  --image-clip: 0 0 22 23
  --image-border: 3
  --text-offset: 0 1
  --icon-color: #dfdfdf   

TabButtonNext < UIButton
  height: 45
  width: 25
  image-source: /images/ui/panels/buttons/tabbutton_right
  image-border: 1
  --image-color: #dfdfdf
  --image-clip: 0 0 22 23
  --image-border: 3
  --text-offset: 0 1
  --icon-color: #dfdfdf   

NextButton < UIButton
  size: 12 21
  image-source: /images/ui/arrow_horizontal
  image-clip: 12 0 12 21
  image-color: #ffffff
  text-offset: 0 1
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 12 21 12 21

  $pressed:
    image-clip: 12 21 12 21

  $disabled:
    image-color: #dfdfdf88
    change-cursor-image: false

PreviousButton < UIButton
  size: 12 21
  image-source: /images/ui/arrow_horizontal
  image-clip: 0 0 12 21
  image-color: #ffffff
  text-offset: 0 1
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 21 12 21

  $pressed:
    image-clip: 0 21 12 21

  $disabled:
    image-color: #dfdfdf88
    change-cursor-image: false

AddButton < UIButton
  size: 20 20
  image-source: /images/ui/icon_add
  image-color: #dfdfdfff
  text-offset: 0 1
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-color: #dfdfdf99

  $pressed:
    image-color: #dfdfdf44

  $disabled:
    image-color: #dfdfdf55
    change-cursor-image: false

NewButton < UIButton
  change-cursor-image: true
  cursor: pointer

  $disabled:
    change-cursor-image: false

DockableOptionsButton < NewButton
  size: 14 12
  image-source: /images/newui/miniwindow/traces
  phantom: false
  opacity: 1.0

  $hover:
    opacity: 0.5

  $pressed:
    opacity: 0.75

TabChatButton < UIButton
  size: 24 24
  //image-source: /images/game/chat/tabBarButtons
  image-clip: 0 0 24 24
  icon-color: white
  opacity: 0.6

  $hover:
    image-clip: 0 24 24 24
    opacity: 1.0

  $disabled:
    icon-color: #888888
    opacity: 0.5