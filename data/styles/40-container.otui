PageButton < Button
  size: 30 18
  margin: 1


ContainerWindow < ContainerMiniWindow
  height: 150
  &save: true
  &containerWindow: true
  image-source: /images/general_ui/background
  opacity: 0.9

  UIItem
    id: containerItemWidget
    virtual: true
    size: 16 16    
    anchors.top: parent.top
    anchors.left: parent.left    
    margin-left: 7
    margin-top: 7
    background: alpha

  NewButton
    id: upButton
    anchors.verticalCenter: optionsButton.verticalCenter
    anchors.right: optionsButton.left
    margin-right: 5
    size: 12 13
    image-source: /images/newui/containers/up_button
    opacity: 0.5

    $hover:
      opacity: 0.8

    $pressed:
      opacity: 1.0

  Panel
    id: pagePanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: miniwindowTopBar.bottom
    margin: 1 3 0 3
    background: #00000066
    height: 20
    
    $on:
      visible: true

    $!on:
      visible: false

    Label
      id: pageLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      text-auto-resize: true            

    PageButton
      id: prevPageButton
      text: <
      anchors.top: parent.top
      anchors.left: parent.left

    PageButton
      id: nextPageButton
      text: >
      anchors.top: parent.top
      anchors.right: parent.right

  MiniWindowContents
    padding-right: 0
    layout:
      type: grid
      cell-size: 34 34
      flow: true
