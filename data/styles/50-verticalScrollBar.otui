NewScrollBarValueLabel < Label
  id: valueLabel
  anchors.fill: parent
  color: white
  text-align: center

NewScrollBarSlider < UIButton
  id: sliderButton
  anchors.centerIn: parent
  size: 13 17
  image-source: /images/newui/scroll_sheet
  image-clip: 0 26 13 13
  image-border: 2
  $hover:
    image-clip: 13 26 13 13
  $pressed:
    image-clip: 26 26 13 13
  $disabled:
  
NewVerticalScrollBar < UIScrollBar
  orientation: vertical
  width: 13
  height: 39
  image-source: /images/newui/scroll_sheet
  image-clip: 39 0 13 65
  image-border: 1
  pixels-scroll: true

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    image-source: /images/newui/scroll_sheet
    image-clip: 0 0 13 13
    size: 13 13
    $hover:
      image-clip: 13 0 13 13
    $pressed:
      image-clip: 26 0 13 13
    $disabled:

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 13 13
    image-source: /images/newui/scroll_sheet
    image-clip: 0 13 13 13
    $hover:
      image-clip: 13 13 13 13
    $pressed:
      image-clip: 26 13 13 13
    $disabled:

  NewScrollBarSlider
  NewScrollBarValueLabel

AllianceVerticalScrollBar < UIScrollBar
  orientation: vertical
  size: 12 397
  
  UIButton
    id: decrementButton
    size: 12 10
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-bottom: 6
    image-source: /images/ui/alliance_arrow_vertical
    image-clip: 0 0 10 7
    cursor: pointer
    $hover:
      image-clip: 10 0 10 7
    $pressed:
      image-clip: 20 0 10 7
    $disabled:
      image-color: #ffffff66

  UIButton
    id: incrementButton
    size: 12 10
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-top: 6
    image-source: /images/ui/alliance_arrow_vertical
    image-clip: 0 7 10 7
    cursor: pointer
    $hover:
      image-clip: 10 7 10 7
    $pressed:
      image-clip: 20 7 10 7
    $disabled:
      image-color: #ffffff66

  UIWidget
    id: backgroundImage
    width: 4
    image-source: /images/ui/scrollbar/slider_vertical_base
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: decrementButton.bottom
    anchors.bottom: incrementButton.top
    margin-top: 6
    margin-bottom: 6
    image-border: 1
  
    $disabled:
      color: #bbbbbb88

  AllianceVerticalScrollBarSlider
  AllianceScrollBarValueLabel

  $on:
    visible: true
      
  $!on:
    visible: false