ComboBoxRounded < ComboBox
  image-source: /images/ui/combobox_rounded
  image-border: 3

NewComboBox < UIComboBox
  font: verdana-11px-antialised
  color: #dfdfdf
  size: 91 23
  text-offset: 5 0
  text-align: left

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

NewComboBoxPopupMenu < UIPopupMenu
  image-source: /images/newinterface/label_select2

NewComboBoxPopupMenuButton < UIButton
  height: 23
  font: verdana-11px-antialised
  text-align: left
  text-offset: 4 0
  color: #dfdfdf
  background-color: alpha
  margin: 1

  $hover !disabled:
    color: #dfdfdf
    background-color: #355d89

  $disabled:
    color: #dfdfdf88

  $first:
    margin-top: 2

OptionsComboBox < UIComboBox
  font: poppins semibold 14
  text-align: left
  text-offset: 8 0
  cursor: pointer
  image-source: /images/general_ui/combobox_background

  UIWidget
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    image-source: /images/general_ui/combobox_option
    phantom: true

    UIWidget
      anchors.centerIn: parent
      image-source: /images/general_ui/combobox_assign
      phantom: true

OptionsComboBoxPopupMenu < UIPopupMenu
  image-source: /images/newinterface/label_select2
  image-border: 4

OptionsComboBoxPopupMenuButton < UIButton
  height: 23
  font: verdana-11px-antialised
  text-align: left
  text-offset: 4 0
  color: #dfdfdf
  background-color: alpha
  margin: 1

  $hover !disabled:
    color: #dfdfdf
    background-color: #355d89

  $disabled:
    color: #dfdfdf88

  $first:
    margin-top: 2