ShopTabBarVertical < UITabBar
  width: 96
  ScrollableFlatPanel
    id: buttonsPanel
    image-color: alpha
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: scrollBar.left
    anchors.bottom: parent.bottom
    vertical-scrollbar: scrollBar
    border-color: red
    border-width: 3
  VerticalScrollBar
    id: scrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 16
    pixels-scroll: true
    $!on:
      width: 0
ShopTabBarVerticalPanel < Panel
ShopTabBarVerticalButton < UIButton
  size: 115 65
  color: alpha
  anchors.left: parent.left
  anchors.right: parent.right
  icon-align: top
  icon-color: #888888
  $first:
    anchors.top: parent.top
  $!first:
    anchors.top: prev.bottom
    margin-top: 5
  $hover !checked:
    icon-color: #cccccc
  $disabled:
    icon-color: #333333
  $checked:
    icon-color: #ffffff

MoveableTabBar < UIMoveableTabBar
  size: 150 30

MoveableTabBarPanel < Panel
MoveableTabBarButton < UIButton  
  image-source: /images/newui/background_popup 
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 3
  padding: 5
  image-border: 5
  font: poppins semibold 10

  $hover !checked:    
    margin-top: 2    
    image-source: /images/ui/panels/tabbutton_square_on
    image-border: 5

  $checked:    
    image-source: /images/ui/panels/tabbutton_square_checked
    image-border: 5

  $disabled:
    image-color: #ffffff66
    icon-color: #888888

  $on !checked:  
    color: #F55E5E

TabBar < UITabBar
  size: 80 21
  Panel
    id: buttonsPanel
    anchors.fill: parent
TabBarPanel < Panel
TabBarButton < UIButton
  size: 20 21
  image-source: /images/ui/tabbutton_square
  image-color: white
  image-clip: 0 0 20 21
  image-border: 3
  --icon-color: white
  --color: #aaaaaa
  anchors.top: parent.top
  padding: 5
  cursor: pointer

  $first:
    anchors.left: parent.left

  $!first:
    anchors.left: prev.right
    margin-left: 5

  $hover !checked:
    image-clip: 0 21 20 21
    color: white

  $disabled:
    image-color: #ffffff66
    icon-color: #888888

  $checked:
    image-clip: 0 42 20 21
    color: #80c7f8

  $on !checked:
    color: #F55E5E

TabBarRounded < TabBar
TabBarRoundedPanel < TabBarPanel
TabBarRoundedButton < TabBarButton
  image-source: /images/ui/panels/tabbutton_rounded

PokedexTabBar < TabBarRounded
PokedexTabBarPanel < TabBarRoundedPanel
PokedexTabBarButton < TabBarRoundedButton
  size: 140 32
  anchor-left: prev.right
  margin-left: 15
  anchor-right: none
  image-source: none
  text-align: center

TabBarVertical < UITabBar
  width: 96
  ScrollableFlatPanel
    id: buttonsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: scrollBar.left
    anchors.bottom: parent.bottom
    vertical-scrollbar: scrollBar
  VerticalScrollBar
    id: scrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 16
    pixels-scroll: true
    $!on:
      width: 0
TabBarVerticalPanel < Panel
TabBarVerticalButton < UIButton
  size: 48 37
  color: #aaaaaa
  anchors.left: parent.left
  anchors.right: parent.right
  margin-left: 10
  margin-right: 10
  text-align: left
  icon-align: top
  icon-offset-y: 2
  icon-color: #888888
  text-offset: 10 0
  cursor: pointer
  font: poppins semibold 14
  image-source: /images/general_ui/option_background
  $first:
    anchors.top: parent.top
  $!first:
    anchors.top: prev.bottom
    margin-top: 3
  $hover !checked:
    color: white
    icon-color: #cccccc
  $disabled:
    icon-color: #333333
  $checked:
    icon-color: #ffffff
    color: #80c7f8
  $on !checked:
    color: #F55E5E
