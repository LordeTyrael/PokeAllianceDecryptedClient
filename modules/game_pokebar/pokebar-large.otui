UIPokeBarItem < UIWidget
  size: 191 56
  draggable: true
  focusable: false

  UIWidget
    id: bar
    draggable: true
    size: 191 56
    image-source: images/bar_default
    opacity: 0.8
    anchors.top: parent.top
    anchors.right: pokeBar.right

  UIProgressBar
    id: life
    draggable: true
    background-color: #08b365
    size: 127 18
    anchors.top: pokeName.bottom
    anchors.left: bar.left
    image-source: images/green_bar
    margin-top: 3
    margin-left: 52

  UIWidget
    id: portrait
    draggable: true
    size: 46 45
    anchors.top: bar.top
    anchors.left: bar.left
    margin-top: 7
    margin-left: 4

  Label
    id: pokeName
    draggable: true
    text-auto-resize: true
    color: #e8c05e
    anchors.left: portrait.right
    anchors.top: bar.top
    margin-top: 12
    margin-left: 13
    font: poppins semibold 12

  Label
    id: percent
    draggable: true
    text-auto-resize: true
    color: #c5e4f9
    anchors.centerIn: life

UIWidget
  id: pokeBar
  size: 191 361
  draggable: true
  focusable: false
  y: 35
  x: 200

  UIPokeBarItem
    id: poke1
    draggable: true
    anchors.top: parent.top

  UIPokeBarItem
    id: poke2
    draggable: true
    anchors.top: poke1.bottom

  UIPokeBarItem
    id: poke3
    draggable: true
    anchors.top: poke2.bottom

  UIPokeBarItem
    id: poke4
    draggable: true
    anchors.top: poke3.bottom

  UIPokeBarItem
    id: poke5
    draggable: true
    anchors.top: poke4.bottom

  UIPokeBarItem
    id: poke6
    draggable: true
    anchors.top: poke5.bottom
