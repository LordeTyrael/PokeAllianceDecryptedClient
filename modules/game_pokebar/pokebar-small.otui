UIPokeBarItem < UIWidget
  size: 149 45
  draggable: true
  focusable: false

  UIWidget
    id: bar
    draggable: true
    size: 149 45
    image-source: images/bar_default
    opacity: 0.8
    anchors.top: parent.top
    anchors.right: pokeBar.right

  UIProgressBar
    id: life
    draggable: true
    background-color: #08b365
    size: 99 15
    anchors.top: pokeName.bottom
    anchors.left: bar.left
    image-source: images/green_bar
    margin-top: 3
    margin-left: 40

  UIWidget
    id: portrait
    draggable: true
    size: 35 35
    anchors.top: bar.top
    anchors.left: bar.left
    margin-top: 6
    margin-left: 4

  Label
    id: pokeName
    draggable: true
    text-auto-resize: true
    color: #e8c05e
    anchors.left: portrait.right
    anchors.top: bar.top
    margin-top: 6
    margin-left: 12
    font: poppins semibold 10

  Label
    id: percent
    draggable: true
    text-auto-resize: true
    color: #c5e4f9
    anchors.centerIn: life

UIWidget
  id: pokeBar
  size: 149 360
  draggable: true
  focusable: false
  y: 35
  x: 200

  UIPokeBarItem
    id: poke1
    draggable: true
    anchors.top: parent.top

  UIPokeBarItem
    id: poke2
    draggable: true
    anchors.top: poke1.bottom

  UIPokeBarItem
    id: poke3
    draggable: true
    anchors.top: poke2.bottom

  UIPokeBarItem
    id: poke4
    draggable: true
    anchors.top: poke3.bottom

  UIPokeBarItem
    id: poke5
    draggable: true
    anchors.top: poke4.bottom

  UIPokeBarItem
    id: poke6
    draggable: true
    anchors.top: poke5.bottom
