Label-14px-Medium < Label
  text-auto-resize: true
  font: poppins semibold 14

OffsetWindow < MainWindow
  id: OffsetWindow
  size: 830 630
  text: Offset Fixer + Auto Target
  draggable: true
  focusable: true
  anchors.centerIn: parent

  Label-14px-Medium
    id: idLabel
    !text: tr('ID:')
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 75
    margin-left: 5

  TextEdit
    id: idInput
    size: 70 38
    anchors.left: idLabel.right
    anchors.top: idLabel.top
    margin-left: 10
    margin-top: -10

    $!text-color:
      color: #2a6e9c

  Label-14px-Medium
    id: subidLabel
    !text: tr('ID2:')
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 75
    margin-left: 115

  TextEdit
    id: subIdInput
    size: 70 38
    anchors.left: subidLabel.right
    anchors.top: subidLabel.top
    margin-left: 10
    margin-top: -10

    $!text-color:
      color: #2a6e9c

  ComboBox
    id: offsetComboBox
    width: 80
    anchors.left: idInput.right
    anchors.top: idInput.top
    margin-left: 135

  ComboBox
    id: displacementTypeComboBox
    width: 168
    anchors.left: offsetComboBox.right
    anchors.top: offsetComboBox.top
    margin-left: 10
    !text: tr('Select Displacement Type')

  ComboBox
    id: effectOpacityComboBox
    width: 140
    anchors.left: offsetComboBox.right
    anchors.top: offsetComboBox.top
    margin-left: 10
    visible: false
    !text: tr('Effect or Item Mode')
    @onOptionChange: OffsetManager.toggleOpacityMode()

  Panel
    id: preview
    anchors.top: effectOpacityComboBox.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 25
    size: 448 224
    clipping: true

    Panel
      id: floor
      anchors.centerIn: parent
      size: 448 224
      border: 4 #110c0a
      image-source: /images/game/offset/Floor
      layout: "anchor"

      ChaseModeBox
        id: movement
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 5
        margin-left: 5
        image-color: #dfdfdf
        tooltip: Enable/Disable movement animation

        $hover:
          image-color: #ffffff

      UIItem
        id: itemView
        size: 128 128
        margin-right: 35
        margin-bottom: 30
        anchors.centerIn: parent

      UIEffect
        id: effectView
        size: 64 64
        anchors.centerIn: parent

      UICreature
        id: outfitView
        anchors.centerIn: parent
        size: 96 96 
        margin-right: 10
        margin-bottom: 1
        outfit-shader: outfit_default

  Panel
    id: OpacityPanel
    size: 250 48
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: preview.bottom
    margin-top: 10
    visible: false

    Label-14px-Medium
      id: opacityLabel
      !text: tr('Opacity:')
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 5
      margin-left: 35

    TextEdit
      id: opacityInput
      size: 70 38
      anchors.left: opacityLabel.right
      anchors.top: opacityLabel.top
      margin-left: 5
      margin-top: -3

      $!text-color:
        color: #2a6e9c

  Panel
    id: OffsetPanel
    size: 130 80
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: OpacityPanel.bottom
    margin-top: -45
    margin-left: -180

    Label-14px-Medium
      id: offsetXLabel
      !text: tr('Offset X:')
      anchors.left: parent.left
      anchors.top: parent.top
      size: 88 25
      text-offset: 0 5
      margin-top: 5

    TextEdit
      id: offsetX
      size: 70 38
      anchors.left: offsetXLabel.right
      anchors.top: offsetXLabel.top
      margin-left: 5
      margin-top: -3

      $!text-color:
        color: #2a6e9c

    Label-14px-Medium
      id: offsetYLabel
      !text: tr('Offset Y:')
      size: 88 25
      text-offset: 0 5
      anchors.left: parent.left
      anchors.top: offsetX.bottom
      margin-top: 5

    TextEdit
      id: offsetY
      size: 70 38
      anchors.left: offsetYLabel.right
      anchors.top: offsetYLabel.top
      margin-left: 5
      margin-top: -3

      $!text-color:
        color: #2a6e9c


  Panel
    id: OpacityOutfit
    size: 130 40
    anchors.horizontalCenter: OffsetPanel.horizontalCenter
    anchors.top: OffsetPanel.bottom
    margin-left: 1

    Label-14px-Medium
      id: opacityLabel
      !text: tr('Opacity:')
      anchors.left: parent.left
      anchors.top: parent.top
      size: 88 25
      text-offset: 0 5
      margin-top: 4
      margin-left: -1

    TextEdit
      id: opacityInput
      size: 70 38
      anchors.left: opacityLabel.right
      anchors.top: opacityLabel.top
      margin-left: 5
      margin-top: -3

      $!text-color:
        color: #2a6e9c

  Panel
    id: SubOutfitPanel
    size: 160 40
    anchors.left: OffsetPanel.right
    anchors.verticalCenter: OffsetPanel.verticalCenter
    margin-left: 15
    margin-top: -20

    CheckBox
      id: subOutfitCheckBox
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 0
      margin-top: 0
      @onClick: OffsetManager.toggleSubOutfitDisplacement()

    Label-14px-Medium
      id: subOutfitLabel
      !text: tr('offset, wings etc')
      anchors.left: subOutfitCheckBox.right
      anchors.verticalCenter: subOutfitCheckBox.verticalCenter
      size: 130 25
      text-offset: -4 5
      margin-left: 5


  Label-14px-Medium
    id: directionsLabel
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: OffsetPanel.bottom
    margin-top: -45

  UIWidget
    id: upButton
    size: 42 42
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    margin-top: -145
    opacity: 1.0
    image-source: /game_offset/images/cima
    @onClick: OffsetManager.onUp()
    $hover:
      opacity: 0.7
    $pressed:
      opacity: 0.5

  UIWidget
    id: downButton
    size: 42 42
    anchors.horizontalCenter: upButton.horizontalCenter
    anchors.top: upButton.bottom
    margin-top: 130
    opacity: 1.0
    image-source: /game_offset/images/baixo
    @onClick: OffsetManager.onDown()
    $hover:
      opacity: 0.7
    $pressed:
      opacity: 0.5

  CheckBox
    id: effectTopCheckBox
    size: 130 25
    anchors.left: downButton.right
    anchors.verticalCenter: downButton.verticalCenter
    margin-left: 10
    !text: tr('top effect')
    visible: false

  UIWidget
    id: leftButton
    size: 42 42
    anchors.right: upButton.left
    anchors.verticalCenter: upButton.verticalCenter
    margin-right: 155
    margin-top: 82
    opacity: 1.0
    image-source: /game_offset/images/esquerda
    @onClick: OffsetManager.onLeft()
    $hover:
      opacity: 0.7
    $pressed:
      opacity: 0.5

  UIWidget
    id: rightButton
    size: 42 42
    anchors.left: upButton.right
    anchors.verticalCenter: upButton.verticalCenter
    margin-left: 155
    margin-top: 82
    opacity: 1.0
    image-source: /game_offset/images/direita
    @onClick: OffsetManager.onRight()
    $hover:
      opacity: 0.7
    $pressed:
      opacity: 0.5

  UIWidget
    id: ResetButton
    size: 47 47
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: directionsLabel.top
    margin-top: 90
    margin-left: 170
    opacity: 1.0
    image-source: /images/game/offset/Reset
    @onClick: OffsetManager.resetOffset()
    $hover:
      opacity: 0.7
    $pressed:
      opacity: 0.5

  Panel
    id: DirectionsPanel
    size: 230 50
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: directionsLabel.bottom
    margin-top: 90

    UIWidget
      id: imageLeft
      size: 16 16
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 30
      image-source: /images/game/offset/Esquerda

    CheckBox
      id: checkLeft
      size: 16 16
      anchors.top: imageLeft.bottom
      anchors.horizontalCenter: imageLeft.horizontalCenter
      margin-top: 2
      margin-left: 2
      @onClick: OffsetManager.toggleDirection('left')

    UIWidget
      id: imageUp
      size: 16 16
      anchors.left: imageRight.right
      anchors.top: parent.top
      margin-left: 30
      image-source: /images/game/offset/Norte

    CheckBox
      id: checkUp
      size: 16 16
      anchors.top: imageUp.bottom
      anchors.horizontalCenter: imageUp.horizontalCenter
      margin-top: 2
      margin-left: 0
      @onClick: OffsetManager.toggleDirection('up')

    UIWidget
      id: imageDown
      size: 16 16
      anchors.left: checkUp.right
      anchors.top: parent.top
      margin-left: 30
      image-source: /images/game/offset/Sul

    CheckBox
      id: checkDown
      size: 16 16
      anchors.top: imageDown.bottom
      anchors.horizontalCenter: imageDown.horizontalCenter
      margin-top: 2
      margin-left: 0
      @onClick: OffsetManager.toggleDirection('down')

    UIWidget
      id: imageRight
      size: 16 16
      anchors.left: checkLeft.right
      anchors.top: parent.top
      margin-left: 30
      image-source: /images/game/offset/Direita

    CheckBox
      id: checkRight
      size: 16 16
      anchors.top: imageRight.bottom
      anchors.horizontalCenter: imageRight.horizontalCenter
      margin-top: 2
      margin-left: 0
      @onClick: OffsetManager.toggleDirection('right')

  Panel
    id: buttonPanel
    size: 500 70
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: -30
    margin-left: -20

    Button
      id: saveButton
      size: 120 30
      anchors.right: viewButton.left
      anchors.top: viewButton.top
      margin-right: 10
      !text: tr('Apply')
      @onClick: OffsetManager.saveOffset()

    Button
      id: applyAllButton
      size: 120 30
      anchors.right: saveButton.left
      anchors.top: saveButton.top
      margin-right: 10
      !text: tr('Apply All')
      @onClick: OffsetManager.applyOffsetToAllDirections()

    Button
      id: viewButton
      size: 120 30
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-left: 10
      !text: tr('View')
      @onClick: OffsetManager.viewOffset()

    Button
      id: fecharButton
      size: 60 30
      anchors.left: dumpButton.right
      anchors.top: parent.top
      margin-left: 10
      !text: tr('Close')
      @onClick: OffsetManager.toggle()

    Button
      id: dumpButton
      size: 60 30
      anchors.left: helpButton.right
      anchors.top: helpButton.top
      margin-left: 10
      !text: tr('Dump')
      @onClick: OffsetManager.dumpModifications()

    Button
      id: directionSyncButton
      size: 120 30
      anchors.left: dumpButton.right
      anchors.top: dumpButton.top
      margin-left: 10
      !text: tr('Sync OFF')
      color: #FF0000
      @onClick: OffsetManager.toggleDirectionSync()

    Button
      id: forceSyncButton
      size: 120 30
      anchors.left: directionSyncButton.right
      anchors.top: directionSyncButton.top
      margin-left: 10
      !text: tr('Force Sync')
      @onClick: OffsetManager.forceSyncDirection()

    Button
      id: useTargetButton
      size: 105 30
      anchors.left: forceSyncButton.right
      anchors.top: forceSyncButton.top
      margin-left: 10
      !text: tr('Use Target')
      @onClick: OffsetManager.useCurrentTarget()

    Button
      id: helpButton
      size: 60 30
      anchors.left: deleteButton.right
      anchors.top: deleteButton.top
      margin-left: 10
      !text: tr('Help')
      @onClick: OffsetManager.showInfo()

    Button
      id: deleteButton
      size: 120 30
      anchors.left: viewButton.right
      anchors.top: viewButton.top
      margin-left: 10
      !text: tr('Delete')
      @onClick: OffsetManager.deleteOffset()
