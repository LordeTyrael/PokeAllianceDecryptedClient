NewOpaqueWindow
  id: quantityWindow
  size: 280 193
  anchors.centerIn: parent
  visible: false
  focusable: true
  @onEscape: modules.game_changeheld.closeQuantityWindow()

  PoppinsSemibold14
    id: quantityTitle
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12
    color: #ffffff

  UIItem
    id: quantityItem
    size: 48 48
    anchors.top: quantityTitle.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    phantom: true
    virtual: true

  AllianceAmountSpinner
    id: quantitySpinner
    anchors.top: quantityItem.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12

  NewStraightBlueButton
    id: confirmButton
    size: 90 30
    anchors.right: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-right: 6
    margin-bottom: 14
    !text: tr("Confirm")
    @onClick: modules.game_changeheld.confirmExchange()

  NewRedButton
    id: cancelButton
    size: 90 30
    anchors.left: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-bottom: 14
    !text: tr("Cancel")
    @onClick: modules.game_changeheld.closeQuantityWindow()

  NewRedCloseButton
    id: closeQuantityBtn
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 8
    margin-right: 8
    @onClick: modules.game_changeheld.closeQuantityWindow()
