// 300 wide, with an icon: 10 + icon 48 + 10 + text 207 + 6 + close 11 + 8
// without one the text starts at 10 and takes the 48+10 back (265 wide).
NotificationCard < UIWidget
  width: 300
  height: 68
  image-source: /images/general_ui/bordered_background
  image-border: 12
  focusable: false
  // the title and message come from the caller, not from a tr() key: bound them
  clipping: true

  UIWidget
    id: icon
    size: 48 48
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    phantom: true
    visible: false

  UICreature
    id: creature
    size: 48 48
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    phantom: true
    old-scaling: true
    visible: false

  UIItem
    id: item
    size: 48 48
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    virtual: true
    phantom: true
    focusable: false
    visible: false

  Label
    id: title
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 68
    margin-top: 9
    width: 207
    height: 17
    text-align: left
    font: poppins semibold 13
    color: #ffffff

  Label
    id: message
    anchors.left: title.left
    anchors.top: title.bottom
    margin-top: 3
    width: 207
    text-wrap: true
    text-align: topLeft
    text-auto-resize: true
    font: poppins semibold 11
    color: #b6bcc4

  // drains left to right over the card's lifetime; hidden on cards that never expire
  UIWidget
    id: timerTrack
    height: 2
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 12
    margin-right: 12
    margin-bottom: 4
    background-color: #ffffff14
    phantom: true

    UIWidget
      id: timerFill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 0
      background-color: #35c1ee
      phantom: true

  NewCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 8
    margin-right: 8
    !tooltip: tr('Dismiss')

// fit-children plus a corner anchor: the stack grows away from the edge it is pinned to
NotificationStack < Panel
  id: notificationStack
  width: 300
  focusable: false

  layout:
    type: verticalBox
    spacing: 6
    fit-children: true
