NewOpaqueWindow
  id: houseLeaveWindow
  size: 360 180
  anchors.centerIn: parent
  visible: false
  focusable: true
  @onEscape: modules.game_house.closeLeaveWindow()
  @onEnter: modules.game_house.confirmLeave()

  UIWidget
    id: base_name
    anchors.left: parent.left
    anchors.top: parent.top
    size: 220 36
    image-source: /images/general_ui/name_base

    Label
      id: base_text
      text-auto-resize: true
      anchors.left: parent.left
      margin-left: 15
      anchors.verticalCenter: parent.verticalCenter
      margin-top: 2
      font: poppins semibold 16
      !text: tr('Leave House')

  NewRedCloseButton
    id: cancelButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 13
    margin-right: 16
    @onClick: modules.game_house.closeLeaveWindow()

  AllianceStraightBlueButton
    id: yesButton
    size: 120 32
    font: poppins semibold 14
    text-align: center
    anchors.bottom: parent.bottom
    anchors.right: parent.horizontalCenter
    margin-bottom: 15
    margin-right: 5
    !text: tr('Yes')
    @onClick: modules.game_house.confirmLeave()

  NewStraightGrayButton
    id: noButton
    size: 120 32
    font: poppins semibold 14
    text-align: center
    anchors.bottom: parent.bottom
    anchors.left: parent.horizontalCenter
    margin-bottom: 15
    margin-left: 5
    !text: tr('No')
    @onClick: modules.game_house.closeLeaveWindow()

  Label
    id: confirmLabel
    anchors.top: base_name.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: yesButton.top
    margin-left: 18
    margin-right: 18
    margin-top: 10
    margin-bottom: 10
    text-wrap: true
    text-align: center
    text-auto-resize: false
    font: poppins semibold 13
    color: #ffffff
    !text: tr('Are you sure you want to leave this house?')
