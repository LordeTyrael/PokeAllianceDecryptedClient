NewOpaqueWindow
  id: houseSellWindow
  size: 320 190
  anchors.centerIn: parent
  visible: false
  focusable: true
  @onEscape: modules.game_house.closeSellWindow()
  @onEnter: modules.game_house.confirmSell()

  UIWidget
    id: base_name
    anchors.left: parent.left
    anchors.top: parent.top
    size: 200 36
    image-source: /images/general_ui/name_base

    Label
      id: base_text
      text-auto-resize: true
      anchors.left: parent.left
      margin-left: 15
      anchors.verticalCenter: parent.verticalCenter
      margin-top: 2
      font: poppins semibold 16
      !text: tr('Sell House')

  NewRedCloseButton
    id: cancelButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 13
    margin-right: 16
    @onClick: modules.game_house.closeSellWindow()

  PoppinsSemibold12
    id: buyerHint
    anchors.top: base_name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 16
    color: #a0b0c0
    !text: tr('Buyer name')

  EntergameTextEdit
    id: buyerEdit
    size: 200 25
    font: poppins semibold 12
    text-offset: 10 2
    placeholder-offset: 10 2
    max-length: 30
    color: white
    focusable: true
    image-source: /modules/client_entergame/images/labelbox_noselect
    anchors.top: buyerHint.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10

    $focus:
      image-source: /modules/client_entergame/images/labelbox_select

  AllianceStraightBlueButton
    id: confirmButton
    size: 120 30
    font: poppins semibold 12
    text-align: center
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 15
    !text: tr('Confirm')
    @onClick: modules.game_house.confirmSell()
