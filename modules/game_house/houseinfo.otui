NewOpaqueWindow
  id: houseInfoWindow
  size: 560 320
  anchors.centerIn: parent
  visible: false
  focusable: true
  @onEscape: modules.game_house.close()

  UIWidget
    id: base_name
    anchors.left: parent.left
    anchors.top: parent.top
    size: 250 36
    image-source: /images/general_ui/name_base

    Label
      id: base_text
      text-auto-resize: true
      anchors.left: parent.left
      margin-left: 15
      anchors.verticalCenter: parent.verticalCenter
      margin-top: 2
      font: poppins semibold 16

  NewRedCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 13
    margin-right: 16
    @onClick: modules.game_house.close()

  UIWidget
    id: icon
    size: 130 110
    image-source: images/house_green
    image-size: 130 110
    image-smooth: true
    anchors.top: base_name.bottom
    anchors.left: parent.left
    margin-top: 18
    margin-left: 45
    phantom: true

  UIWidget
    id: clockIcon
    size: 20 20
    icon-source: @fa solid 16 f017
    icon-color: #ffffff
    anchors.top: icon.bottom
    anchors.horizontalCenter: icon.horizontalCenter
    margin-top: 6
    phantom: true

  PoppinsSemibold13
    id: countdownLabel
    anchors.verticalCenter: clockIcon.verticalCenter
    anchors.left: clockIcon.right
    margin-left: 8
    color: #ffffff

  PoppinsSemibold11
    id: countdownHint
    anchors.top: clockIcon.bottom
    anchors.horizontalCenter: icon.horizontalCenter
    margin-top: 4
    color: #a0b0c0

  PoppinsSemibold13
    id: ownerKey
    anchors.top: base_name.bottom
    anchors.left: parent.left
    margin-top: 18
    margin-left: 235
    color: #e8d36a
    !text: tr('Owner')

  PoppinsSemibold13
    id: ownerValue
    anchors.verticalCenter: ownerKey.verticalCenter
    anchors.right: parent.right
    margin-right: 30
    color: #ffffff

  PoppinsSemibold13
    id: townKey
    anchors.top: ownerKey.bottom
    anchors.left: ownerKey.left
    margin-top: 10
    color: #e8d36a
    !text: tr('Town')

  PoppinsSemibold13
    id: townValue
    anchors.verticalCenter: townKey.verticalCenter
    anchors.right: parent.right
    margin-right: 30
    color: #ffffff

  PoppinsSemibold13
    id: sizeKey
    anchors.top: townKey.bottom
    anchors.left: ownerKey.left
    margin-top: 10
    color: #e8d36a
    !text: tr('Size')

  PoppinsSemibold13
    id: sizeValue
    anchors.verticalCenter: sizeKey.verticalCenter
    anchors.right: parent.right
    margin-right: 30
    color: #ffffff

  PoppinsSemibold13
    id: priceKey
    anchors.top: sizeKey.bottom
    anchors.left: ownerKey.left
    margin-top: 10
    color: #e8d36a
    !text: tr('Price')

  PoppinsSemibold13
    id: priceValue
    anchors.verticalCenter: priceKey.verticalCenter
    anchors.right: parent.right
    margin-right: 30
    color: #ffffff

  PoppinsSemibold13
    id: maxBidKey
    anchors.top: priceKey.bottom
    anchors.left: ownerKey.left
    margin-top: 10
    color: #e8d36a
    !text: tr('Your bid limit')

  PoppinsSemibold13
    id: maxBidValue
    anchors.verticalCenter: maxBidKey.verticalCenter
    anchors.right: parent.right
    margin-right: 30
    color: #ffffff

  PoppinsSemibold13
    id: statusKey
    anchors.top: maxBidKey.bottom
    anchors.left: ownerKey.left
    margin-top: 10
    color: #e8d36a
    !text: tr('Status')

  PoppinsSemibold13
    id: statusValue
    anchors.verticalCenter: statusKey.verticalCenter
    anchors.right: parent.right
    margin-right: 30
    color: #ffffff

  PoppinsSemibold13
    id: currentBidKey
    anchors.top: statusKey.bottom
    anchors.left: ownerKey.left
    margin-top: 10
    color: #e8d36a
    !text: tr('Current bid')

  PoppinsSemibold13
    id: currentBidValue
    anchors.verticalCenter: currentBidKey.verticalCenter
    anchors.right: parent.right
    margin-right: 30
    color: #ffffff

  AllianceStraightBlueButton
    id: bidButton
    size: 200 34
    font: poppins semibold 14
    text-align: center
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 15
    !text: tr('Bid')
    @onClick: modules.game_house.openBidWindow()

  AllianceStraightBlueButton
    id: leaveButton
    size: 130 34
    font: poppins semibold 14
    text-align: center
    anchors.bottom: parent.bottom
    anchors.right: parent.horizontalCenter
    margin-bottom: 15
    margin-right: 5
    visible: false
    !text: tr('Leave house')
    @onClick: modules.game_house.leaveHouse()

  NewRedButton
    id: sellButton
    size: 130 34
    font: poppins semibold 14
    text-align: center
    anchors.bottom: parent.bottom
    anchors.left: parent.horizontalCenter
    margin-bottom: 15
    margin-left: 5
    visible: false
    !text: tr('Sell house')
    @onClick: modules.game_house.sellHouse()
