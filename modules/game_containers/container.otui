ContainerWindow < MiniWindow
  height: 150
  &save: true
  &containerWindow: true

  UIItem
    id: containerItemWidget
    virtual: true
    size: 16 16
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 1
    margin-left: 3

  UIButton
    id: upButton
    anchors.top: optionsButton.top
    anchors.right: optionsButton.left
    margin-right: 3
    size: 12 13
    image-source: /images/newui/containers/up_button
    opacity: 0.5

    $hover:
      opacity: 0.8

    $pressed:
      opacity: 1.0

  Panel
    id: pagePanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: miniwindowTopBar.bottom
    margin: 1 3 0 3
    background: #00000066
    height: 20
    
    $on:
      visible: true

    $!on:
      visible: false

    Label
      id: pageLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      text-auto-resize: true

    PageButton
      id: prevPageButton
      text: <
      anchors.top: parent.top
      anchors.left: parent.left

    PageButton
      id: nextPageButton
      text: >
      anchors.top: parent.top
      anchors.right: parent.right