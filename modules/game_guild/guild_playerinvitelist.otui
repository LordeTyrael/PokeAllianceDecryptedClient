NewOpaqueWindow
  id: guild_playerinvitelist
  size: 248 232
  visible: false

  PoppinsSemibold20
    anchors.top: parent.top
    margin-top: 5
    anchors.horizontalCenter: parent.horizontalCenter
    !text: tr("Invite List")    

  UIScrollArea
    id: invitesContent
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    anchors.right: invitesContentScrollBar.left
    width: 220
    margin-top: 50
    margin-left: 15
    margin-right: 15
    margin-bottom: 15
    vertical-scrollbar: invitesContentScrollBar    

  AllianceVerticalScrollBar
    id: invitesContentScrollBar
    anchors.right: parent.right
    anchors.top: close.bottom
    anchors.bottom: parent.bottom
    margin-top: 19
    margin-bottom: 15
    margin-right: 20
    step: 30

  NewRedCloseButton
    id: close
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 10
    margin-right: 10
    @onClick: modules.game_guild.playerInviteListClose()

PlayerInviteRow < UIWidget
  height: 30

  CommonCell
    id: name
    size: 120 30
    anchors.left: parent.left
    text-align: left
    !text: tr('Guild Name')

  CommonCell
    id: action
    size: 50 30
    anchors.left: prev.right
    anchors.right: parent.right
    !text: tr('Action')