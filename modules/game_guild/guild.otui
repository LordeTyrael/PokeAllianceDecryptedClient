BlackButton < UIWidget
  size: 139 32
  image-source: images/black_button
  color: #ffffff
  $on:
    color: #000000
    image-source: images/white_button

GuildShopItem < UIWidget
  size: 153 95
  image-source: images/guild_shop/item_background

  $focus:
    image-source: images/guild_shop/selected_item_background

  UIWidget
    id: item_icon
    size: 33 33
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 8
    image-source: images/guild_shop/item_icon_background
    phantom: true

  UIItem
    id: item
    size: 32 32
    anchors.centerIn: item_icon
    phantom: true

  Label
    id: itemName
    text-auto-resize: true
    font: poppins semibold 12
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: item_icon.bottom
    margin-top: 5
    phantom: true

  UIWidget
    id: priceInfo
    size: 35 24
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: itemName.bottom
    margin-top: 3
    phantom: true

    UIItem
      size: 24 24
      item-id: 39993
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      phantom: true

    Label
      id: itemPrice
      text-auto-resize: true
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      phantom: true

GuildTabButton < UIWidget
  height: 32
  font: poppins semibold 14
  color: #b0b8c0
  text-align: center
  cursor: pointer
  border-width: 0
  image-source: /images/modules/guild/button_background
  image-border: 12
  $on:
    color: #ffffff
    image-source: /images/newui/blueSoft
    image-border: 8

BuffWidget < UIWindow
  size: 120 108
  image-source: /images/newui/background_3
  image-border: 15
  focusable: false
  draggable: false
  
  UIWidget
    id: background
    size: 56 56
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 8
    margin-left: 8
    phantom: true

  Label
    id: buffLevel
    size: 24 24
    anchors.left: background.right
    margin-left: -12
    anchors.bottom: background.bottom
    font: poppins boldbordered 12
    text-align: center
    phantom: true

  Label
    id: buffName
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: background.bottom
    margin-top: 3
    margin-left: 6
    margin-right: 6
    height: 32
    text-wrap: true
    text-align: center
    font: poppins semibold 12
    phantom: true

  NewButton
    id: buffImprovement
    size: 14 14
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    image-source: /images/game/minimap/cross
    margin-right: 6
    margin-bottom: 6
    @onClick: modules.game_guild.progressGuildBuff(self:getParent())

  UIProgressBar
    id: levelProgress
    size: 20 56
    anchors.top: background.top
    anchors.bottom: background.bottom
    anchors.right: parent.right
    margin-right: 6
    image-source: images/progressExperience
    phantom: true

  UIProgressBar
    id: progressPercent
    size: 20 56
    anchors.right: levelProgress.right
    anchors.bottom: levelProgress.bottom
    anchors.top: levelProgress.top
    image-source: images/progress
    image-border: 5
    phantom: true

RankMembers < UIWidget
  id: rankRow
  margin-top: 8

  UIWidget
    id: rankTitle
    font: sans-bold-16px
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter

  UIWidget
    id: members
    margin-top: 8
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    layout:
      type: grid
      cell-size: 165 60
      num-columns: 3
      cell-spacing: 1
      flow: true

RankMember < NewOpaqueWindow
  width: 165
  height: 60

  UIWidget
    id: emblem
    size: 40 40
    margin-left: 4
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left

  UIWidget
    margin-left: 2
    margin-top: 2
    anchors.top: parent.top
    anchors.left: prev.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    anchors.verticalCenter: parent.verticalCenter

    UIWidget
      id: name
      font: poppins semibold 12
      text-align: center
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top

    UIWidget
      id: level
      font: poppins semibold 11
      text-align: center
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right

    UIWidget
      id: lastLogin
      size: 20 18
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 2

      UIWidget
        id: loginIcon
        size: 14 14
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 30
        phantom: true

      UIWidget
        id: lastLoginTime
        font: poppins semibold 11
        anchors.top: parent.top
        anchors.left: loginIcon.right
        margin-left: 4
        text-auto-resize: true
        text-align: center
        phantom: true

CommonCell < UIItem
  height: 30
  font: poppins semibold 10
  anchors.top: parent.top
  anchors.left: parent.left
  border-width-bottom: 1
  border-color: #2F3239
  virtual: true
  phantom: true

AuditRow < UIWidget
