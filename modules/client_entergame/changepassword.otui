UIWidget
  id: changePasswordWindow
  size: 668 420
  visible: false
  focusable: true
  anchors.centerIn: parent
  image-source: images/redesign/card-frame
  image-border: 18

  UIWidget
    id: artPanel
    width: 266
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    phantom: true
    clip-transparency: true
    image-source: images/redesign/card-art-mask
    image-border: 18

    UIWidget
      anchors.fill: parent
      phantom: true
      image-source: images/redesign/card-art
      image-clip: 0 52 266 420

  UIWidget
    id: logo
    size: 76 76
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 30
    margin-left: 26
    image-source: /images/pka/logo
    image-smooth: true
    phantom: true

  PkaArtSubtitle
    id: artSubtitle
    width: 214
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 26
    margin-bottom: 30
    !text: tr("Use a strong password you don't use anywhere else.")

  PkaArtTitle
    id: artTitle
    width: 214
    anchors.left: parent.left
    anchors.bottom: artSubtitle.top
    margin-left: 26
    margin-bottom: 8
    !text: tr('Keep your account safe')

  PkaCardTitle
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 24
    margin-left: 296
    !text: tr('Change Password')

  PkaCardSubtitle
    id: subtitle
    anchors.top: title.bottom
    anchors.left: title.left
    margin-top: 2
    !text: tr('Confirm your identity to set a new password')

  PkaFieldLabel
    id: passwordLabel
    anchors.top: subtitle.bottom
    anchors.left: parent.left
    margin-top: 16
    margin-left: 296
    !text: tr('YOUR PASSWORD')

  PkaInput
    id: passwordTextEdit
    height: 42
    text-offset: 13 12
    placeholder-offset: 13 12
    text-hidden: true
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 296
    margin-right: 30

  PkaFieldLabel
    id: newPasswordLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 14
    margin-left: 296
    !text: tr('NEW PASSWORD')

  PkaInput
    id: newPasswordEdit
    height: 42
    text-offset: 13 12
    placeholder-offset: 13 12
    text-hidden: true
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 296
    margin-right: 30

  PkaFieldLabel
    id: confirmPasswordLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 14
    margin-left: 296
    !text: tr('CONFIRM PASSWORD')

  PkaInput
    id: confirmPasswordTextEdit
    height: 42
    text-offset: 13 12
    placeholder-offset: 13 12
    text-hidden: true
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 296
    margin-right: 30

  PkaGhostButton
    id: backButton
    size: 84 44
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 28
    margin-left: 296
    !text: tr('Back')
    @onClick: CreateCharacter.doCloseChangePassword()

  PkaPrimaryButton
    id: confirmButton
    height: 44
    anchors.bottom: parent.bottom
    anchors.left: backButton.right
    anchors.right: parent.right
    margin-bottom: 28
    margin-left: 9
    margin-right: 30
    !text: tr('Change Password')
    @onClick: CreateCharacter.doChangePassword()
