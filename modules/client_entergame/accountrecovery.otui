UIWidget
  id: accountRecoveryWindow
  size: 668 420
  focusable: true
  anchors.centerIn: parent
  image-source: images/redesign/card-frame
  image-border: 18

  UIWidget
    id: artPanel
    width: 266
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    phantom: true
    clip-transparency: true
    image-source: images/redesign/card-art-mask
    image-border: 18

    UIWidget
      anchors.fill: parent
      phantom: true
      image-source: images/redesign/card-art
      image-clip: 0 52 266 420

  UIWidget
    id: logo
    size: 76 76
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 30
    margin-left: 26
    image-source: /images/pka/logo
    image-smooth: true
    phantom: true

  PkaArtSubtitle
    id: artSubtitle
    width: 214
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 26
    margin-bottom: 30
    !text: tr("No worries, we'll help you get back into your account.")

  PkaArtTitle
    id: artTitle
    width: 214
    anchors.left: parent.left
    anchors.bottom: artSubtitle.top
    margin-left: 26
    margin-bottom: 8
    !text: tr('Lost your access?')

  PkaCardTitle
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 24
    margin-left: 296
    !text: tr('Account Recovery')

  PkaCardSubtitle
    id: subtitle
    anchors.top: title.bottom
    anchors.left: title.left
    margin-top: 2
    !text: tr('Enter your account email to receive a recovery link.')

  PkaFieldLabel
    id: identifierLabel
    anchors.top: subtitle.bottom
    anchors.left: parent.left
    margin-top: 16
    margin-left: 296
    !text: tr('EMAIL')

  PkaInput
    id: identifierTextEdit
    height: 44
    text-offset: 13 13
    placeholder-offset: 13 13
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 296
    margin-right: 30
    !placeholder: tr('Email or Account name')

  PkaInfoBox
    id: infoBox
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 14
    margin-left: 296
    margin-right: 30

    UIWidget
      id: infoIcon
      size: 16 16
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 14
      icon-source: @fa solid 15 f05a
      icon-color: #6fb6fb
      phantom: true

    Label
      id: infoText
      anchors.left: infoIcon.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      margin-right: 12
      font: poppins regular 12
      color: #b4c4decc
      text-align: left
      text-wrap: true
      text-auto-resize: true
      phantom: true
      !text: tr('The recovery link expires in 30 minutes for your security.')

  PkaGhostButton
    id: backButton
    size: 84 46
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 28
    margin-left: 296
    !text: tr('Back')
    @onClick: AccountRecovery.doOpenEnterGameWindow()

  PkaPrimaryButton
    id: sendButton
    anchors.bottom: parent.bottom
    anchors.left: backButton.right
    anchors.right: parent.right
    margin-bottom: 28
    margin-left: 9
    margin-right: 30
    !text: tr('Send Recovery')
    @onClick: AccountRecovery.doSendRecovery()
