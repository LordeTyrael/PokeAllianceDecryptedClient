    !text: tr("Fairy")
    image-source: images/labels/fairy
    @onClick: applyFilters("fairy")
    &icon:
      image-source: images/mainimages/fairy

  TalentFilterButton
    id: fighting
    !text: tr("Fighting")
    image-source: images/labels/fighting
    @onClick: applyFilters("fighting")
