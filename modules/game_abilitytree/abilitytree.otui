    &icon:
      image-source: images/mainimages/water

FilterPanelScrollBar < AllianceVerticalScrollBar
  id: filterPanelScrollBar
  width: 12
  anchors.top: filterPanel.top
  anchors.bottom: filterPanel.bottom
  anchors.left: filterPanel.right
  margin-left: 4
  step: 44
  pixels-scroll: true

TalentCategoryHeader < UIWidget
  id: header
  height: 40
  anchors.top: base_name.bottom
  anchors.left: filterPanelScrollBar.right
  anchors.right: parent.right
  margin-top: 12
  margin-left: 12
  margin-right: 30
  background-color: #101d2baa
  focusable: false
  phantom: true

  UIWidget
    id: headerIcon
    size: 28 28
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 12

  Label
    id: headerTitle
    text-auto-resize: true
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: headerIcon.right
    margin-left: 10
    margin-top: 2
    font: poppins semibold 15
    color: #ffffff

  // fixed width: a right-anchored text-auto-resize label grows past its anchor
  Label
    id: headerCount
    size: 170 20
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    margin-right: 12
    text-align: right
    font: poppins semibold 12
    color: #8fb7d6

  AllianceProgressBar
    id: headerProgress
    size: 140 10
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: headerCount.left
    margin-right: 10

AbilityPanel < UIScrollArea
  id: abilityPanel
  focusable: false
  anchors.top: header.bottom
  anchors.bottom: parent.bottom
  anchors.left: filterPanelScrollBar.right
  anchors.right: parent.right
  margin-top: 11
  margin-bottom: 12
  margin-left: 12
  margin-right: 12
  vertical-scrollbar: abilityPanelScrollBar

AbilityPanelScrollBar < AllianceVerticalScrollBar
  id: abilityPanelScrollBar
  width: 12
  anchors.top: abilityPanel.top
  anchors.bottom: abilityPanel.bottom
  anchors.right: abilityPanel.right
  step: 87
  pixels-scroll: true

// 860 = 12 + 180 (filters) + 4 + 12 (scrollbar) + 12 + 610 (rows) + 6 + 12 (scrollbar) + 12
// 540 = 36 (title) + 12 + 40 (header) + 11 + 429 (5 rows of 81 + 4 gaps of 6) + 12
NewOpaqueWindow
  id: abilitytree
  size: 860 540
  anchors.centerIn: parent
  @onEscape: modules.game_abilitytree.close()

  UIWidget
    id: base_name
    anchors.left: parent.left
    anchors.top: parent.top
    size: 330 36
    image-source: /images/general_ui/name_base

    UIWidget
      id: base_icon
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-left: 10
      size: 32 32
      image-source: /images/game/icons/poketalent

    Label
      id: base_text
      text-auto-resize: true
      anchors.left: base_icon.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      margin-top: 4
      font: poppins semibold 20
      !text: tr("Player Talents")

  NewRedCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 8
    margin-right: 8
    @onClick: modules.game_abilitytree.close()

  SearchableHint
    id: searchHint
    anchors.verticalCenter: closeButton.verticalCenter
    anchors.right: closeButton.left
    margin-right: 8
    !tooltip: tr("Hold Shift over an item to see which Pokemon drop it")

  FilterPanel
  FilterPanelScrollBar
  TalentCategoryHeader
  AbilityPanel
  AbilityPanelScrollBar
