AbilityItem < UIItem
  size: 32 32
  image-source: /images/newui/containers/item
  virtual: true
  searchable: true
  focusable: false

// 612x81 rows: 16 + icon 48 + 16 + desc 328 + 16 + recipe 172 + 16.
AbilityItemWidget < UIWidget
  height: 81
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  margin-top: 0
  margin-right: 18
  image-source: /images/modules/talents_ui/item_background
  focusable: false

  $!first:
    anchors.top: prev.bottom
    margin-top: 6

  UIWidget
    id: mainImage
    size: 48 48
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 16
    phantom: true

  UIWidget
    id: desc
    width: 328
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: mainImage.right
    margin-top: 8
    margin-bottom: 8
    margin-left: 17
    text-align: topLeft
    text-wrap: true
    font: poppins semibold 12
    color: #dfe7ef
    phantom: true

  // width/height come from the recipe size in applyFilters (5 columns max).
  UIWidget
    id: recipe
    size: 172 67
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    margin-right: 16
    layout:
      type: grid
      cell-size: 32 32
      num-columns: 5
      cell-spacing: 3

TalentFilterButton < UIButton
  size: 180 40
  font: poppins semibold 14
  text-align: left
  text-offset: 48 1
  color: #8ea3b8
  opacity: 0.62
  icon-source: @fa solid 12 f0da
  icon-color: #ffffff00
  icon-align: right
  icon-offset: -8 0
  anchors.left: parent.left
  anchors.top: prev.bottom
  margin-top: 4
  change-cursor-image: true
  cursor: pointer

  UIWidget
    id: icon
    size: 40 40
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 5
    phantom: true

  $hover:
    color: #cfdae8
    opacity: 0.88

  $checked:
    color: #ffffff
    opacity: 1.0
    icon-color: #35c1ee

FilterPanel < ScrollablePanel
  id: filterPanel
  width: 180
  focusable: false
  anchors.left: parent.left
  anchors.top: base_name.bottom
  anchors.bottom: parent.bottom
  margin-left: 12
  margin-top: 12
  margin-bottom: 12
  vertical-scrollbar: filterPanelScrollBar

  TalentFilterButton
    id: character
    !text: tr("Character")
    image-source: images/labels/character
    anchors.top: parent.top
    margin-top: 0
    @onClick: applyFilters("character")
    &icon:
      image-source: images/mainimages/character

  TalentFilterButton
    id: pokemon
    !text: tr("Pokémon")
    image-source: images/labels/character
    @onClick: applyFilters("pokemon")
    &icon:
      image-source: images/mainimages/pokemon

  TalentFilterButton
    id: bug
    !text: tr("Bug")
    image-source: images/labels/bug
    @onClick: applyFilters("bug")
    &icon:
      image-source: images/mainimages/bug

  TalentFilterButton
    id: dark
    !text: tr("Dark")
    image-source: images/labels/dark
    @onClick: applyFilters("dark")
    &icon:
      image-source: images/mainimages/dark

  TalentFilterButton
    id: dragon
    !text: tr("Dragon")
    image-source: images/labels/dragon
    @onClick: applyFilters("dragon")
    &icon:
      image-source: images/mainimages/dragon

  TalentFilterButton
