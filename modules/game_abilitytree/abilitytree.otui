      image-source: images/mainimages/fighting

  TalentFilterButton
    id: fire
    !text: tr("Fire")
    image-source: images/labels/fire
    @onClick: applyFilters("fire")
    &icon:
      image-source: images/mainimages/fire

  TalentFilterButton
    id: flying
    !text: tr("Flying")
    image-source: images/labels/flying
    @onClick: applyFilters("flying")
    &icon:
      image-source: images/mainimages/flying

  TalentFilterButton
    id: ghost
    !text: tr("Ghost")
    image-source: images/labels/ghost
    @onClick: applyFilters("ghost")
    &icon:
      image-source: images/mainimages/ghost

  TalentFilterButton
    id: grass
    !text: tr("Grass")
    image-source: images/labels/grass
    @onClick: applyFilters("grass")
    &icon:
      image-source: images/mainimages/grass

  TalentFilterButton
    id: ground
    !text: tr("Ground")
    image-source: images/labels/ground
    @onClick: applyFilters("ground")
    &icon:
      image-source: images/mainimages/ground

  TalentFilterButton
    id: ice
    !text: tr("Ice")
    image-source: images/labels/ice
    @onClick: applyFilters("ice")
    &icon:
      image-source: images/mainimages/ice

  TalentFilterButton
    id: normal
    !text: tr("Normal")
    image-source: images/labels/normal
    @onClick: applyFilters("normal")
    &icon:
      image-source: images/mainimages/normal

  TalentFilterButton
    id: poison
    !text: tr("Poison")
    image-source: images/labels/poison
