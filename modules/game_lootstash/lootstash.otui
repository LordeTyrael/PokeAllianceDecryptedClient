UIMiniWindow
  id: lootStashWindow
  height: 250
  @onClose: modules.game_lootstash.onMiniWindowClose()
  &save: true
  &autoOpen: true
  image-source: /images/general_ui/bordered_background
  focusable: false
  &minimizedHeight: 26
  image-border: 12

  ContainerMiniWindowTopbar
    id: miniwindowTopBar
    padding: 3

  UIWidget
    id: miniwindowIcon
    size: 16 16
    anchors.left: miniwindowTopBar.left
    margin-left: 6
    anchors.verticalCenter: miniwindowTopBar.verticalCenter
    image-source: images/title_icon

  Label
    id: miniwindowName
    text-auto-resize: true
    anchors.left: miniwindowIcon.right
    margin-left: 4
    anchors.verticalCenter: miniwindowIcon.verticalCenter
    anchors.right: optionsButton.left
    margin-right: 2
    font: poppins semibold 14
    !text: tr("Loot Stash")
    text-offset: 0 4

  NewButton
    id: closeButton
    anchors.top: miniwindowTopBar.top
    anchors.right: miniwindowTopBar.right
    margin-top: 8
    margin-right: 7
    size: 11 11
    image-source: /images/newui/miniwindow/close
    opacity: 1.0

    $hover:
      opacity: 0.5

    $pressed:
      opacity: 0.75

  NewButton
    id: minimizeButton
    anchors.right: closeButton.left
    margin-right: 5
    anchors.verticalCenter: closeButton.verticalCenter
    size: 11 7
    image-source: /images/newui/miniwindow/arrows
    image-clip: 0 0 11 7
    opacity: 1.0

    $hover:
      opacity: 0.5

    $on:
      image-clip: 0 7 11 7

  NewButton
    id: lockButton
    anchors.right: minimizeButton.left
    anchors.verticalCenter: closeButton.verticalCenter
    margin-right: 5
    size: 13 15
    image-source: /images/newui/miniwindow/lock
    image-clip: 0 15 13 15
    opacity: 1.0

    $hover:
      opacity: 0.5

    $on:
      image-clip: 0 0 13 15

  DockableOptionsButton
    id: optionsButton
    anchors.right: lockButton.left
    anchors.verticalCenter: closeButton.verticalCenter
    margin-right: 7

  UIWidget
    id: buttonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: miniwindowTopBar.bottom
    height: 30
    margin-top: 2
    margin-left: 3
    margin-right: 3

    NewStraightGreenButton
      id: depotStash
      size: 85 24
      anchors.left: parent.left
      margin-left: 4
      anchors.verticalCenter: parent.verticalCenter
      font: poppins semibold 12
      text-align: center
      !tooltip: tr("Transfer to Depot Stash")
      !text: tr("Stash")
      @onClick: modules.game_lootstash.requestStashLootToDepot()

    AllianceStraightBlueButton
      id: collectAll
      size: 85 24
      anchors.right: parent.right
      margin-right: 4
      anchors.verticalCenter: parent.verticalCenter
      font: poppins semibold 12
      text-align: center
      !tooltip: tr("Collect All")
      !text: tr("Collect")
      @onClick: modules.game_lootstash.requestWithdrawLootStash()

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 100
    margin-left: 3
    margin-right: 3
    background: #ffffff88

  AllianceVerticalScrollBar
    id: miniwindowScrollBar
    anchors.top: buttonsPanel.bottom
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 30
    margin-top: 2
    margin-bottom: 5
    margin-right: 4
    pixels-scroll: true

  MiniWindowContents
    id: contentsPanel
    anchors.top: buttonsPanel.bottom
    margin-top: 2
    padding: 1

    layout:
      type: grid
      cell-size: 32 32
      num-columns: 5
      cell-spacing: 2
