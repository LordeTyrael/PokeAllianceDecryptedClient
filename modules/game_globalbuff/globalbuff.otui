BuffCard < UIWidget
  size: 220 120
  image-source: /images/newui/background_3
  image-border: 15

  Label
    id: buffName
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    font: poppins bold 13
    color: #ffffff
    !text: tr('Buff Name')
    text-align: center
    text-auto-resize: true

  Label
    id: statusLabel
    anchors.top: buffName.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    font: poppins semibold 10
    color: #7f8fa4
    !text: tr('Collecting...')
    text-align: center
    text-auto-resize: true
    text-wrap: true

  UIWidget
    id: progressBarBg
    size: 196 22
    image-source: images/bar_bg
    anchors.top: statusLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4

    UIWidget
      id: progressFill
      size: 0 18
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      image-source: images/bar_exp
      phantom: true

    Label
      id: progressText
      font: poppins semibold 10
      color: #ffffff
      anchors.centerIn: parent
      text-align: center
      text-offset: 0 2
      text-auto-resize: true
      text: 0 / 500kk
      phantom: true

  UIWidget
    id: timerBarBg
    size: 196 22
    image-source: images/bar_bg
    anchors.top: activeIcon.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    visible: false

    UIWidget
      id: timerFill
      size: 192 18
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      image-source: images/bar_timer
      phantom: true

    Label
      id: timerText
      font: poppins semibold 12
      color: #ffffff
      anchors.centerIn: parent
      text-align: center
      text-offset: 0 2
      text-auto-resize: true
      text:
      phantom: true

  UIWidget
    id: activeIcon
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: statusLabel.bottom
    margin-top: 6
    size: 48 48
    visible: false

  Panel
    id: tierPanel
    size: 188 22
    anchors.top: progressBarBg.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 20
    layout:
      type: horizontalBox
      spacing: 4

TierButton < NewBlueButton
  size: 60 22
  font: poppins semibold 10
  text-align: center
  text-offset: 5 1
  cursor: pointer

NewOpaqueWindow
  id: globalBuffWindow
  anchors.centerIn: parent
  size: 712 470
  draggable: true
  @onEscape: modules.game_globalbuff.hide()

  UIWidget
    id: base_name
    anchors.left: parent.left
    anchors.top: parent.top
    size: 368 36
    image-source: /images/modules/store_ui/name_base

    UIWidget
      id: base_icon
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-left: 10
      size: 32 28
      image-source: /images/modules/store_ui/base_icon

    Label
      id: base_text
      text-auto-resize: true
      anchors.left: base_icon.right
      margin-left: 10
      anchors.verticalCenter: parent.verticalCenter
      margin-top: 2
      font: poppins semibold 20
      !text: tr("Community Bonus")

  NewRedCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 10
    margin-right: 10
    @onClick: modules.game_globalbuff.hide()

  UIWidget
    id: backgroundImage
    height: 200
    image-source: /images/modules/background_community
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 16
    margin-right: 16
    anchors.top: base_name.bottom
    margin-top: 10
    anchors.horizontalCenter: parent.horizontalCenter

  Panel
    id: buffContainer
    anchors.top: backgroundImage.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    margin-left: 16
    margin-right: 16
    height: 150
    layout:
      type: horizontalBox
      spacing: 10

  Panel
    id: bottomPanel
    anchors.left: backgroundImage.left
    anchors.right: backgroundImage.right
    anchors.bottom: parent.bottom
    margin-bottom: 10
    height: 40

    UIItem
      id: bankIcon
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      size: 32 32
      item-id: 37382
      virtual: true
      phantom: true

    PoppinsSemibold14
      id: bankLabel
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: bankIcon.right
      margin-left: 6
      font: poppins semibold 14
      color: #ffffff
      text: $0

    NewGreenButton
      id: shopButton
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      size: 90 28
      font: poppins semibold 12
      !text: tr('Shop')
      cursor: pointer
      @onClick: modules.game_globalbuff.showShop()

    PoppinsSemibold14
      id: pointsLabel
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: shopButton.left
      margin-right: 12
      font: poppins semibold 14
      color: #ffcc00
      !text: tr('Community Points: 0')
