PokedexCard < UIWidget
  image-source: images/ui/card
  image-border: 12

PokedexCardTitle < Label
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 8
  margin-left: 12
  font: poppins semibold 12
  color: #6b7280
  text-auto-resize: true
  phantom: true

PokedexInfoText < Label
  font: poppins semibold 12
  color: #b6bcc4
  text-align: left
  text-wrap: true
  text-auto-resize: true
  phantom: true

PokedexSearch < UITextEdit
  height: 26
  font: poppins semibold 12
  color: #e8eaed
  image-source: images/ui/input
  image-border: 10
  padding: 4
  padding-left: 10
  placeholder-color: #6b7280
  selection-color: #e8eaed
  selection-background-color: #2e343c

PokedexListRow < UIWidget
  height: 30
  focusable: true
  image-source: images/ui/row
  image-border: 9
  image-color: alpha
  cursor: pointer

  $focus:
    image-color: #2399f1

  UIWidget
    id: ball
    size: 11 11
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    image-source: pokeball
    image-smooth: true
    visible: false
    phantom: true

  Label
    id: number
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 24
    width: 42
    height: 20
    font: poppins semibold 12
    color: #6b7280
    text-align: left
    phantom: true

  UIWidget
    id: dot
    size: 8 8
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    icon-source: @fa solid 8 f111
    icon-color: #262b32
    phantom: true

  Label
    id: name
    anchors.left: number.right
    anchors.right: dot.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    margin-right: 6
    height: 20
    font: poppins semibold 12
    color: #e8eaed
    text-align: left
    phantom: true

PokedexSegButton < UIWidget
  height: 26
  font: poppins semibold 12
  text-align: center
  color: #b6bcc4
  image-source: images/ui/row
  image-border: 9
  image-color: alpha
  opacity: 1.0
  cursor: pointer

  $on:
    image-color: #2399f1
    color: #ffffff

  $hover !on:
    opacity: 0.8

PokedexChip < UIWidget
  height: 22
  font: poppins semibold 12
  text-align: center
  text-offset: 0 2
  color: #e8eaed
  image-source: images/ui/chip
  image-border: 10
  image-border-left: 12
  image-border-right: 12
  phantom: true

PokedexTypeChip < PokedexChip
  text-offset: 10 0

  UIWidget
    id: icon
    size: 16 16
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    image-source: elements
    image-clip: 0 0 24 24
    image-smooth: true

PokedexSoftChip < UIWidget
  height: 22
  font: poppins semibold 12
  text-align: center
  text-offset: 0 2
  color: #b6bcc4
  padding-left: 12
  padding-right: 12
  text-horizontal-auto-resize: true
  image-source: images/ui/capsule
  image-border: 10
  image-border-left: 12
  image-border-right: 12
  image-color: #262b32
  phantom: true

PokedexElementIcon < UIWidget
  size: 24 24
  image-source: elements
  image-clip: 0 0 24 24

PokedexEffectIcon < UIWidget
  size: 24 24
  image-source: effects
  image-clip: 0 0 24 24

PokedexEvoStage < UIWidget
  size: 96 110
  image-source: images/ui/row
  image-border: 9
  image-color: alpha
  cursor: pointer

  UIWidget
    id: sprite
    size: 52 52
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    image-smooth: true
    phantom: true

  Label
    id: stageName
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 30
    height: 20
    font: poppins semibold 12
    color: #b6bcc4
    text-align: center
    phantom: true

  Label
    id: stageLv
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 8
    height: 20
    font: poppins semibold 12
    color: #6b7280
    text-align: center
    phantom: true

PokedexEvoArrow < UIWidget
  size: 30 110
  phantom: true

  UIWidget
    id: arrow
    size: 14 14
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 26
    icon-source: @fa solid 12 f061
    phantom: true

PokedexStoneIcon < UIItem
  size: 26 26
  virtual: true

PokedexCatchRow < UIWidget
  height: 74
  image-source: images/ui/card
  image-border: 12

  Label
    id: playerName
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 10
    margin-left: 14
    height: 20
    font: poppins semibold 13
    color: #e8eaed
    text-align: left
    text-auto-resize: true
    phantom: true

  PokedexSoftChip
    id: worldChip
    anchors.left: playerName.right
    anchors.verticalCenter: playerName.verticalCenter
    margin-left: 8

  Label
    id: date
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 12
    margin-right: 14
    height: 18
    font: poppins semibold 12
    color: #6b7280
    text-align: right
    text-auto-resize: true
    phantom: true

  Label
    id: catchInfo
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 14
    margin-right: 14
    margin-bottom: 8
    height: 36
    font: poppins semibold 12
    color: #8a929e
    text-align: left
    text-wrap: true
    phantom: true

PokedexStoneGroupRow < UIWidget
  height: 30
  phantom: true

  Panel
    id: stoneIcons
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    height: 26
    layout:
      type: horizontalBox
      spacing: 2
      fit-children: true

  Label
    id: evoName
    anchors.left: parent.left
    anchors.right: stoneIcons.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    height: 20
    font: poppins semibold 12
    color: #b6bcc4
    text-align: left
    phantom: true

PokedexEffRow < UIWidget
  height: 40
  phantom: true

  Label
    id: effName
    anchors.left: parent.left
    anchors.top: parent.top
    width: 132
    height: 18
    font: poppins semibold 12
    text-align: left
    phantom: true

  Label
    id: effMult
    anchors.left: parent.left
    anchors.top: effName.bottom
    width: 132
    height: 18
    font: poppins semibold 12
    text-align: left
    phantom: true

  Panel
    id: effIcons
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 132
    height: 24
    layout:
      type: horizontalBox
      spacing: 4

PokedexMoveRow < UIWidget
  height: 46
  image-source: images/ui/card
  image-border: 12

  UIItem
    id: moveIcon
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    text-align: bottomLeft
    font: poppins semibold 12
    text-offset: 2 -2

  PokedexElementIcon
    id: moveElement
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10

  Panel
    id: moveEffects
    anchors.right: moveElement.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    height: 24
    layout:
      type: horizontalBox
      spacing: 3
      fit-children: true

  Label
    id: moveName
    anchors.left: moveIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    font: poppins semibold 12
    color: #e8eaed
    text-auto-resize: true
    phantom: true

  PokedexChip
    id: moveBadge
    anchors.left: moveName.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    height: 20
    font: poppins semibold 12
    image-source: images/ui/capsule

PokedexLootCard < UIWidget
  image-source: images/ui/card
  image-border: 12

  UIItem
    id: item
    size: 32 32
    virtual: true
    searchable: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10

  Label
    id: name
    anchors.left: item.right
    anchors.top: parent.top
    anchors.right: chance.left
    margin-left: 8
    margin-top: 9
    margin-right: 8
    height: 20
    font: poppins semibold 12
    color: #e8eaed
    text-align: left
    phantom: true

  Label
    id: qty
    anchors.left: item.right
    anchors.top: name.bottom
    margin-left: 8
    margin-top: 1
    font: poppins semibold 12
    color: #6b7280
    text-auto-resize: true
    phantom: true

  Label
    id: chance
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 10
    margin-top: 9
    font: poppins semibold 12
    color: #e8eaed
    text-auto-resize: true
    phantom: true

  UIWidget
    id: barTrack
    size: 70 4
    anchors.right: parent.right
    anchors.top: chance.bottom
    margin-right: 10
    margin-top: 5
    background-color: #262b32
    phantom: true

    UIWidget
      id: barFill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 0
      background-color: #3b82c4
      phantom: true

NewOpaqueWindow
  id: pokedexWindow
  size: 900 620
  opacity: 0.97
  visible: false
  focusable: true
  @onEscape: modules.game_pokedex.hide()

  UIWidget
    id: titleIcon
    size: 20 20
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 11
    margin-left: 16
    image-source: pokeball
    image-smooth: true
    phantom: true

  Label
    id: titleLabel
    anchors.left: titleIcon.right
    anchors.verticalCenter: titleIcon.verticalCenter
    margin-left: 8
    font: poppins semibold 16
    color: #e8eaed
    text-auto-resize: true
    !text: tr('PokeDex')
    phantom: true

  Label
    id: capturedLabel
    anchors.left: titleLabel.right
    anchors.verticalCenter: titleIcon.verticalCenter
    margin-left: 12
    font: poppins semibold 12
    color: #6b7280
    text-auto-resize: true
    phantom: true

  NewRedCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 12
    margin-right: 14
    @onClick: modules.game_pokedex.hide()

  SearchableHint
    id: searchHint
    anchors.verticalCenter: closeButton.verticalCenter
    anchors.right: closeButton.left
    margin-right: 8
    !tooltip: tr("Hold Shift over an item to see which Pokemon drop it")

  UIWidget
    id: titleSeparator
    height: 1
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 42
    margin-left: 14
    margin-right: 14
    background-color: #22262c
    phantom: true

  Panel
    id: leftPanel
    width: 232
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 50
    margin-left: 14
    margin-bottom: 14

    PokedexSearch
      id: search
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      !placeholder: tr('Search')
      @onTextChange: modules.game_pokedex.onSearchTextChange()

    AllianceVerticalScrollBar
      id: pokemonListScrollBar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 34
      step: 30
      pixels-scroll: true

    TextList
      id: pokemonList
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: pokemonListScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 34
      margin-right: 4
      vertical-scrollbar: pokemonListScrollBar
      background-color: alpha
      border-width: 0
      padding: 0
      focusable: false

  Panel
    id: heroPanel
    height: 178
    anchors.top: parent.top
    anchors.left: leftPanel.right
    anchors.right: parent.right
    margin-top: 50
    margin-left: 14
    margin-right: 14
    image-source: images/ui/content
    image-border: 12

    UIWidget
      id: heroGradient
      anchors.fill: parent
      image-source: images/ui/hero
      image-color: alpha
      phantom: true

    UIWidget
      id: pBackground
      size: 150 131
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 16
      image-smooth: true
      phantom: true

      UIWidget
        id: pImage
        size: 120 120
        anchors.centerIn: parent
        image-smooth: true
        phantom: true

    PokedexSoftChip
      id: worldCountLabel
      anchors.bottom: pBackground.bottom
      anchors.right: pBackground.right
      margin-right: 4
      color: #e8eaed
      phantom: false
      visible: false
      !tooltip: tr('Currently existing in this world')

    UIButton
      id: redButton
      size: 42 42
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 14
      margin-right: 14
      image-source: images/shiny_icon
      image-smooth: true
      visible: false
      @onClick: modules.game_pokedex.onRedButtonClicked()
      !tooltip: tr('Change Form')

    UIButton
      id: searchLocalizationButton
      size: 26 26
      anchors.top: redButton.bottom
      anchors.horizontalCenter: redButton.horizontalCenter
      margin-top: 8
      image-source: /images/game/icons/lupa
      image-smooth: true
      visible: false
      @onClick: modules.game_pokedex.onSearchLocalizationClicked()
      !tooltip: tr('Search Localization')

    Label
      id: pokeName
      anchors.left: pBackground.right
      anchors.top: parent.top
      margin-left: 8
      margin-top: 32
      font: poppins semibold 24
      color: #e8eaed
      text-auto-resize: true
      phantom: true

    Label
      id: pokeId
      anchors.left: pokeName.right
      anchors.bottom: pokeName.bottom
      margin-left: 10
      margin-bottom: 5
      font: poppins semibold 13
      color: #6b7280
      text-auto-resize: true
      phantom: true

    Panel
      id: chipsPanel
      height: 22
      anchors.left: pBackground.right
      anchors.top: pokeName.bottom
      anchors.right: redButton.left
      margin-left: 8
      margin-top: 10
      margin-right: 8
      layout:
        type: horizontalBox
        spacing: 6

    Panel
      id: flagsPanel
      height: 24
      anchors.left: pBackground.right
      anchors.top: chipsPanel.bottom
      anchors.right: redButton.left
      margin-left: 8
      margin-top: 10
      margin-right: 8
      layout:
        type: horizontalBox
        spacing: 8

      UIWidget
        id: roleIcon
        size: 24 24
        image-smooth: true
        visible: false

      UIWidget
        id: heavyIcon
        size: 24 24
        image-source: images/heavy
        image-smooth: true
        visible: false
        !tooltip: tr('Heavy')

      UIWidget
        id: fastIcon
        size: 24 24
        image-source: images/fast
        image-smooth: true
        visible: false
        !tooltip: tr('Fast')

  UIWidget
    id: tabsPanel
    height: 32
    anchors.top: heroPanel.bottom
    anchors.left: leftPanel.right
    anchors.right: parent.right
    margin-top: 10
    margin-left: 14
    margin-right: 14
    image-source: images/ui/toggle
    image-border: 10

    PokedexSegButton
      id: infoTabButton
      width: 110
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      !text: tr('Info')
      @onClick: modules.game_pokedex.selectTab('info')

    PokedexSegButton
      id: movesTabButton
      width: 110
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      !text: tr('Moves')
      @onClick: modules.game_pokedex.selectTab('moves')

    PokedexSegButton
      id: lootTabButton
      width: 110
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      !text: tr('Loot')
      @onClick: modules.game_pokedex.selectTab('loot')

    PokedexSegButton
      id: catchesTabButton
      width: 150
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      !text: tr('Last Catches')
      @onClick: modules.game_pokedex.selectTab('catches')

  Panel
    id: contentPanel
    anchors.top: tabsPanel.bottom
    anchors.left: leftPanel.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 10
    margin-left: 14
    margin-right: 14
    margin-bottom: 14
    image-source: images/ui/content
    image-border: 12

    Panel
      id: infoTab
      anchors.fill: parent

      AllianceVerticalScrollBar
        id: infoScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 8
        margin-bottom: 8
        margin-right: 4
        step: 30
        pixels-scroll: true

      ScrollablePanel
        id: infoScroll
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: infoScrollBar.left
        anchors.bottom: parent.bottom
        margin: 12
        margin-right: 6
        phantom: false
        vertical-scrollbar: infoScrollBar

        Panel
          id: infoList
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          layout:
            type: verticalBox
            spacing: 8
            fit-children: true

          PokedexInfoText
            id: description
            margin-bottom: 2

          UIWidget
            id: evoRow
            height: 128
            phantom: false

            PokedexCard
              id: evoCard
              width: 400
              anchors.top: parent.top
              anchors.left: parent.left
              anchors.bottom: parent.bottom
              phantom: false

              PokedexCardTitle
                !text: tr('EVOLUTIONS')

              Panel
                id: evoChain
                anchors.top: parent.top
                anchors.left: parent.left
                anchors.right: parent.right
                margin-top: 26
                margin-left: 16
                margin-right: 16
                height: 110
                phantom: false

              Label
                id: evoNote
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: evoChain.bottom
                margin-left: 12
                margin-right: 12
                margin-top: 6
                height: 20
                font: poppins semibold 12
                color: #6b7280
                text-align: left
                text-wrap: true
                visible: false
                phantom: true

            PokedexCard
              id: stoneCard
              anchors.top: parent.top
              anchors.left: evoCard.right
              anchors.right: parent.right
              anchors.bottom: parent.bottom
              margin-left: 8

              Panel
                id: stoneList
                anchors.top: parent.top
                anchors.left: parent.left
                anchors.right: parent.right
                margin-top: 28
                margin-left: 12
                margin-right: 10
                layout:
                  type: verticalBox
                  spacing: 2
                  fit-children: true

              PokedexCardTitle
                !text: tr('EVOLVE STONE')

          PokedexCard
            id: abilitiesCard
            height: 66

            PokedexCardTitle
              !text: tr('FIELD ABILITIES')

            Panel
              id: abilityChips
              anchors.top: parent.top
              anchors.left: parent.left
              anchors.right: parent.right
              anchors.bottom: parent.bottom
              margin-top: 28
              margin-left: 12
              margin-right: 12
              margin-bottom: 8
              layout:
                type: grid
                cell-size: 106 24
                cell-spacing: 4
                flow: true

          PokedexCard
            id: effCard
            height: 100

            PokedexCardTitle
              !text: tr('EFFECTIVENESS - DAMAGE TAKEN')

            Panel
              id: effRows
              anchors.top: parent.top
              anchors.left: parent.left
              anchors.right: parent.right
              margin-top: 28
              margin-left: 12
              margin-right: 12
              layout:
                type: verticalBox
                spacing: 2
                fit-children: true

    Panel
      id: movesTab
      anchors.fill: parent
      visible: false

      Label
        id: movesetLabel
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 12
        margin-left: 12
        font: poppins semibold 12
        color: #6b7280
        text-auto-resize: true
        !text: tr('MOVESET')
        phantom: true

      UIWidget
        id: moveToggle
        size: 130 26
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: 8
        margin-right: 12
        image-source: images/ui/toggle
        image-border: 10

        PokedexSegButton
          id: pveButton
          width: 60
          height: 20
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 3
          text: PVE
          @onClick: modules.game_pokedex.setMoveMode('pve')

        PokedexSegButton
          id: pvpButton
          width: 60
          height: 20
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 3
          text: PVP
          @onClick: modules.game_pokedex.setMoveMode('pvp')

      Label
        id: moveHint
        anchors.top: movesetLabel.bottom
        anchors.left: parent.left
        margin-top: 2
        margin-left: 12
        font: poppins semibold 12
        color: #6b7280
        text-auto-resize: true
        phantom: true

      AllianceVerticalScrollBar
        id: movesScrollBar
        anchors.top: moveHint.bottom
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 6
        margin-bottom: 8
        margin-right: 4
        step: 30
        pixels-scroll: true

      ScrollablePanel
        id: movesScroll
        anchors.top: moveHint.bottom
        anchors.left: parent.left
        anchors.right: movesScrollBar.left
        anchors.bottom: parent.bottom
        margin-top: 6
        margin-left: 12
        margin-right: 6
        margin-bottom: 12
        phantom: false
        vertical-scrollbar: movesScrollBar

        Panel
          id: movesList
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          layout:
            type: verticalBox
            spacing: 6
            fit-children: true

    Panel
      id: lootTab
      anchors.fill: parent
      visible: false

      Label
        id: lootLabel
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 12
        margin-left: 12
        font: poppins semibold 12
        color: #6b7280
        text-auto-resize: true
        !text: tr('LOOT BY ZONE')
        phantom: true

      UIWidget
        id: regionToggle
        size: 195 26
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: 8
        margin-right: 12
        image-source: images/ui/toggle
        image-border: 10

        PokedexSegButton
          id: baseButton
          width: 46
          height: 20
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 3
          text: Base
          @onClick: modules.game_pokedex.setRegion('Base')

        PokedexSegButton
          id: wildscapeButton
          width: 79
          height: 20
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 3
          text: Wildscape
          @onClick: modules.game_pokedex.setRegion('Wildscape')

        PokedexSegButton
          id: primalButton
          width: 58
          height: 20
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 3
          text: Primal
          @onClick: modules.game_pokedex.setRegion('Primal')

      AllianceVerticalScrollBar
        id: lootScrollBar
        anchors.top: regionToggle.bottom
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 6
        margin-bottom: 8
        margin-right: 4
        step: 30
        pixels-scroll: true

      ScrollablePanel
        id: lootScroll
        anchors.top: regionToggle.bottom
        anchors.left: parent.left
        anchors.right: lootScrollBar.left
        anchors.bottom: parent.bottom
        margin-top: 6
        margin-left: 12
        margin-right: 6
        margin-bottom: 12
        phantom: false
        vertical-scrollbar: lootScrollBar

        Panel
          id: lootList
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          layout:
            type: grid
            cell-size: 288 56
            cell-spacing: 8
            num-columns: 2
            fit-children: true


    Panel
      id: catchesTab
      anchors.fill: parent
      visible: false

      AllianceVerticalScrollBar
        id: catchesScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 8
        margin-bottom: 8
        margin-right: 4
        step: 30
        pixels-scroll: true

      ScrollablePanel
        id: catchesScroll
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: catchesScrollBar.left
        anchors.bottom: parent.bottom
        margin: 12
        margin-right: 6
        phantom: false
        vertical-scrollbar: catchesScrollBar

        Panel
          id: catchesList
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          layout:
            type: verticalBox
            spacing: 8
            fit-children: true

// Legenda de zona do fullmap. Vive DENTRO do widget do minimapa (irma do fullmapTimePanel) e e
// criada/destruida junto com os marcadores, entao abrir o fullmap por Ctrl+Tab, sem busca, nao
// mostra legenda nenhuma.
// Mesmo desenho do OptionCheckBox das opcoes: rotulo a esquerda, SwitchBox a direita.
PokedexLegendRow < UIWidget
  height: 26
  anchors.left: parent.left
  anchors.right: parent.right

  UIWidget
    id: pin
    size: 16 16
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true

  Label
    id: name
    font: poppins semibold 12
    color: #e8eaed
    text-auto-resize: true
    anchors.left: pin.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    phantom: true

  // O @onCheckChange do estilo base do SwitchBox usa `not self:isChecked()` e move o slider para o
  // lado ERRADO -- UICheckBox:onClick ja chamou setChecked antes de disparar, entao isChecked() aqui
  // e o valor NOVO. O OptionCheckBox das opcoes sobrescreve com a versao certa; fazemos o mesmo.
  // Toda a logica mora no modulo para o Lua nao sobrescrever este handler ao ligar o seu.
  SwitchBox
    id: check
    checked: true
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    @onCheckChange: modules.game_pokedex.onLegendToggle(self:getParent():getId(), self:isChecked())

PokedexMapLegend < NewOpaqueWindow
  id: pokedexMapLegend
  draggable: false
  focusable: false
  size: 178 118

  Label
    id: title
    !text: tr('Legend')
    font: poppins semibold 11
    color: #8b93a1
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 10
    margin-left: 12
    phantom: true

  PokedexLegendRow
    id: rowCommon
    anchors.top: title.bottom
    margin-top: 6
    margin-left: 12
    margin-right: 10

  PokedexLegendRow
    id: rowWildscape
    anchors.top: rowCommon.bottom
    margin-left: 12
    margin-right: 10

  PokedexLegendRow
    id: rowPrimal
    anchors.top: rowWildscape.bottom
    margin-left: 12
    margin-right: 10
