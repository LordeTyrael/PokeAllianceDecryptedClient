NewOpaqueWindow
  @onEscape: modules.game_trainer.closePasswordPanel()
  id: main
  size: 300 360
  anchors.centerIn: parent

  Label
    id: title
    font: poppins semibold 22
    !text: tr("Put your Password")
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 8
    text-auto-resize: true

  UILabel
    id: passwordValue
    text: ""
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: title.bottom
    margin-top: 6
    text-align: center
    text-auto-resize: true
    font: poppins semibold 14

  UIWidget
    id: numberPanel
    size: 166 166
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: passwordValue.bottom
    margin-top: 15

    layout:
      type: grid
      cell-size: 50 50
      cell-spacing: 8
      num-columns: 2
      flow: true

    NewStraightBlueButton
      id: setPassword1
      size: 50 50
      !text: tr("1")
      @onClick: modules.game_trainer.onPasswordDigit('1')

    NewStraightBlueButton
      id: setPassword2
      size: 50 50
      !text: tr("2")
      @onClick: modules.game_trainer.onPasswordDigit('2')

    NewStraightBlueButton
      id: setPassword3
      size: 50 50
      !text: tr("3")
      @onClick: modules.game_trainer.onPasswordDigit('3')

    NewStraightBlueButton
      id: setPassword4
      size: 50 50
      !text: tr("4")
      @onClick: modules.game_trainer.onPasswordDigit('4')

    NewStraightBlueButton
      id: setPassword5
      size: 50 50
      !text: tr("5")
      @onClick: modules.game_trainer.onPasswordDigit('5')

    NewStraightBlueButton
      id: setPassword6
      size: 50 50
      !text: tr("6")
      @onClick: modules.game_trainer.onPasswordDigit('6')

    NewStraightBlueButton
      id: setPassword7
      size: 50 50
      !text: tr("7")
      @onClick: modules.game_trainer.onPasswordDigit('7')

    NewStraightBlueButton
      id: setPassword8
      size: 50 50
      !text: tr("8")
      @onClick: modules.game_trainer.onPasswordDigit('8')

    NewStraightBlueButton
      id: setPassword9
      size: 50 50
      !text: tr("9")
      @onClick: modules.game_trainer.onPasswordDigit('9')

  NewStraightBlueButton
    id: setPassword0
    anchors.horizontalCenter: numberPanel.horizontalCenter
    anchors.top: numberPanel.bottom
    margin-top: 10
    size: 50 50
    !text: tr("0")
    @onClick: modules.game_trainer.onPasswordDigit('0')

  NewStraightGreenButton
    id: confirmButton
    anchors.horizontalCenter: numberPanel.horizontalCenter
    anchors.top: setPassword0.bottom
    margin-top: 10
    size: 100 35
    !text: tr("Confirm")
    @onClick: modules.game_trainer.onPasswordConfirm()

  NewRedCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 10
    margin-right: 10
    @onClick: modules.game_trainer.closePasswordPanel()