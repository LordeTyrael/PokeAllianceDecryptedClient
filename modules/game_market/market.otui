MarketTab < UIWidget
  height: 30
  font: lucida-11px-rounded
  anchors.top: comboBox.top
  anchors.left: comboBox.right

HistoricPanel < UIWidget
  id: historicPanel
  font: lucida-11px-rounded
  anchors.fill: parent
  anchors.top: buyTabButton.bottom
  visible: false

  UIScrollArea
    id: list
    layout: verticalBox
    font: lucida-11px-rounded
    anchors.fill: parent
    margin-left: 15
    margin-top: 10
    margin-right: 25
    margin-bottom: 50
    vertical-scrollbar: historicVerticalSrollBar
    image-source: images/background_label

  NewVerticalScrollBar
    font: lucida-11px-rounded
    id: historicVerticalSrollBar
    anchors.top: list.top
    anchors.bottom: list.bottom
    anchors.left: list.right
    margin-left: 6
    step: 20
    pixels-scroll: true

RequestsPanel < UIWidget
  id: requestsPanel
  font: lucida-11px-rounded
  anchors.fill: parent
  anchors.top: buyTabButton.bottom
  visible: false

  UIWidget
    id: backgroundImage
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: images/background_label
    margin-top: 10
    margin-left: 140
    margin-right: 140
    margin-bottom: 100

  MarketTab
    id: time
    font: lucida-11px-rounded
    width: 40
    text: #
    anchors.top: backgroundImage.top
    anchors.left: backgroundImage.left
    margin-top: 5
    margin-left: 50

  MarketTab
    id: item
    font: lucida-11px-rounded
    width: 30
    anchors.left: time.right
    anchors.top: prev.top
    !text: tr("Item")
  MarketTab
    id: name
    width: 180
    font: lucida-11px-rounded
    anchors.left: item.right
    anchors.top: prev.top
    !text: tr("Name")
  MarketTab
    id: amount
    font: lucida-11px-rounded
    width: 70
    anchors.left: prev.right
    anchors.top: prev.top
    !text: tr("Qtd.")
  MarketTab
    id: price
    font: lucida-11px-rounded
    width: 100
    anchors.left: amount.right
    anchors.top: prev.top
    !text: tr("Preço")
  MarketTab
    id: status
    font: lucida-11px-rounded
    width: 90
    anchors.left: price.right
    anchors.top: prev.top
    !text: tr("Status")
  MarketTab
    id: timer
    width: 90
    font: lucida-11px-rounded
    anchors.left: status.right
    anchors.top: prev.top
    !text: tr("Tempo")
  MarketTab
    id: cancel
    font: lucida-11px-rounded
    size: 80 30
    anchors.top: prev.top
    anchors.left: timer.right
    text-align: center
    margin-top: 0
    !text: tr("-")

  UIScrollArea
    id: items
    font: lucida-11px-rounded
    layout: verticalBox
    anchors.top: time.bottom
    anchors.bottom: backgroundImage.bottom
    anchors.left: backgroundImage.left
    anchors.right: backgroundImage.right
    vertical-scrollbar: scrollbar
    margin-bottom: 10
    margin-top: 10

  NewVerticalScrollBar
    id: scrollbar
    anchors.top: backgroundImage.top
    anchors.right: backgroundImage.right
    anchors.bottom: items.bottom
    margin-right: 6
    margin-top: 3
    step: 40

  NewButton
    id: refreshButton3
    font: sans-bold-16px
    size: 105 45
    anchors.top: backgroundImage.bottom
    anchors.left: parent.left
    margin-left: 120
    margin-top: 15
    !text: tr("Refresh")
    image-source: /images/newui/btngreen_small
    @onClick: modules.game_market.getMyRequests()

SellPanelWindow < HeadlessWindow
  id: sellPanelWindow
  font: verdana-11px-antialised
  size: 450 250  
  anchors.centerIn: parent
  visible: false
  image-source: images/background_sell_confirm

  UIWidget
    id: close
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 3
    margin-right: 8
    @onClick: self:getParent():hide()
    image-source: images/close

  Button
    id: sell_selectitem
    font: verdana-11px-antialised
    size: 115 30
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter    
    margin-top: 50
    text: Select Item
    !tooltip: tr("Select an Item")
    @onClick: modules.game_market.selectItemToSell()
  Item
    id: sell_item
    font: verdana-11px-antialised
    size: 36 36
    anchors.top: parent.top
    anchors.left: parent.left    
    margin-top: 75
    margin-left: 30
  UIWidget
    id: sell_itemname
    font: verdana-11px-antialised
    size: 200 30
    anchors.top: sell_item.top
    anchors.left: prev.right
    margin-top: 5    
    margin-left: 5
    text-align: left
  UIWidget
    id: sell_pricelabel
    font: verdana-11px-antialised
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 75
    margin-right: 17
    !text: tr("Price per Unit")
  TextEdit
    id: sell_priceedit
    size: 80 20
    anchors.top: sell_pricelabel.bottom
    anchors.right: parent.right
    margin-top: 5
    margin-right: 17
    max-length: 9
    @onTextChange: modules.game_market.onSellPriceChange()
  HorizontalScrollBar
    id: sell_amount
    size: 203 12
    anchors.top: prev.bottom    
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 15
    enabled: false
    margin-left: 25
    margin-right: 25
  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom    
    margin-top: 10
    margin-left: 10
    margin-right: 10
  ComboBox
    id: sell_timebox
    font: verdana-11px-antialised
    anchors.top: prev.bottom
    anchors.right: parent.right
    margin-top: 5
    visible: false  
  CheckBox2
    id: sell_anonymous
    !text: tr('Sell as anonymous')        
    anchors.right: parent.right
    anchors.top: sell_amount.bottom
    margin-top: 15
    width: 150
  UIWidget
    id: sell_value
    font: verdana-11px-antialised
    width: 130
    height: 60    
    anchors.left: parent.left
    anchors.top: sell_amount.bottom
    margin-top: 15
    margin-left: 30
    text-align: topLeft     
  Button
    id: sell_confirm
    font: verdana-11px-antialised
    size: 75 25
    anchors.top: sell_anonymous.bottom
    anchors.right: parent.right
    margin-right: 20
    margin-top: 5
    !text: tr("Confirm")
    @onClick: modules.game_market.onConfirmSellItem()  

