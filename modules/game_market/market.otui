  NewButton
    id: sellWindowButton
    font: sans-bold-16px
    size: 105 45
    anchors.left: refreshButton2.right
    anchors.bottom: refreshButton2.bottom
    margin-left: 10
    !text: tr("Sell Item")
    image-source: /images/newui/btngreen_small
    @onClick: modules.game_market.showSellPanelWindow()

BuyPanel < UIWidget
  id: buyPanel
  font: lucida-11px-rounded
  anchors.fill: parent
  anchors.top: buyTabButton.bottom

  UIWidget
    id: backgroundImage
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: images/background_label
    margin-top: 10
    margin-left: 43
    margin-right: 43
    margin-bottom: 100

  NewComboBox
    id: comboBox
    size: 150 32
    font: lucida-11px-rounded
    anchors.top: backgroundImage.top
    anchors.left: backgroundImage.left
    text-align: center
    text-offset: 16 0
    margin-top: 5
    margin-left: 15
    image-source: images/label_select

  UIWidget
    id: filterImage
    anchors.left: comboBox.left
    anchors.verticalCenter: comboBox.verticalCenter
    margin-left: 10
    size: 16 16
    image-source: images/icon_filter

  MarketTab
    id: time
    font: lucida-11px-rounded
    width: 40
    text: #
  MarketTab
    id: item
    font: lucida-11px-rounded
    width: 30
    padding: 2 4
    anchors.left: time.right
    !text: tr("Item")
  MarketTab
    id: name
    width: 180
    font: lucida-11px-rounded
    anchors.left: item.right
    !text: tr("Name")
  MarketTab
    id: seller
    width: 155
    font: lucida-11px-rounded
    anchors.left: name.right
    !text: tr("Vendedor")
  MarketTab
    id: amount
    font: lucida-11px-rounded
    width: 70
    anchors.left: seller.right
    !text: tr("Qtd.")
  MarketTab
    id: price
    font: lucida-11px-rounded
    width: 100
    anchors.left: amount.right
    !text: tr("Preço")
  MarketTab
    id: timer
    width: 90
    font: lucida-11px-rounded
    anchors.left: price.right
    !text: tr("Tempo")
  UIScrollArea
    id: items
    font: lucida-11px-rounded
    layout: verticalBox
    anchors.top: time.bottom
    anchors.bottom: backgroundImage.bottom
    anchors.left: comboBox.left
    anchors.right: timer.right
    vertical-scrollbar: scrollbar
    margin-bottom: 10
    margin-top: 10
  NewVerticalScrollBar
    id: scrollbar
    anchors.top: timer.top
    anchors.left: timer.right
    anchors.bottom: items.bottom
    margin-left: 8
    step: 20
  PageWidget
  NewButton
    id: refreshButton
    font: sans-bold-16px
    size: 105 30
    anchors.bottom: pageWidget.bottom
    anchors.right: backgroundImage.right
    margin-right: 10
    !text: tr("Refresh")
    image-source: /images/newui/btngreen_small
    @onClick: modules.game_market.getBuyItems()
BuyTabButton < NewButton
  id: buyTabButton
  font: poppins semibold 12
  size: 92 32
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 65
  margin-left: 43
  text: Buy
  !tooltip: tr("Check offers")
  @onClick: modules.game_market.showBuyPanel()
  image-source: images/label_unit
SellTabButton < NewButton
  id: sellTabButton
  font: verdana-11px-antialised
  size: 92 32
  anchors.top: buyTabButton.top
  anchors.left: buyTabButton.right
  margin-left: 10
  text: Sell
  !tooltip: tr("Advertise your items")
  @onClick: modules.game_market.showSellPanel()
  image-source: images/label_search
HistoricTabButton < NewButton
  id: historicTabButton
  font: verdana-11px-antialised
  size: 92 32
  anchors.top: buyTabButton.top
  anchors.left: sellTabButton.right
  margin-left: 10
  text: Trade Logs
  !tooltip: tr("Check your trade logs")
  @onClick: modules.game_market.showHistoricPanel()
  image-source: images/label_search
RequestsTabButton < NewButton
  id: requestsTabButton
  font: verdana-11px-antialised
  size: 92 32
  anchors.top: buyTabButton.top
  anchors.left: historicTabButton.right
  margin-left: 10
  text: My Requests
  !tooltip: tr("Check your buy requests")
  @onClick: modules.game_market.showRequestsPanel()
  image-source: images/label_search
SearchText < TextEdit
  id: searchEdit
  size: 120 32
  text-offset: 0 16
  text-align: center
  color: white
  anchors.top: buyTabButton.top
  anchors.right: parent.right
  margin-right: 43
  @onTextChange: modules.game_market.onTextChange()
  image-source: images/label_search

  $focus:
    image-source: images/label_select

MarketClose < NewButton
  id: close
  anchors.top: background.top
  anchors.right: background.right
  margin-top: 10
  margin-right: 6
  @onClick: modules.game_market.hide()
  image-source: images/close

UIWidget
  id: market
  size: 940 600
  anchors.centerIn: parent
  padding: 2
  @onEscape: modules.game_market.hide()

  UIWidget
    id: background
    anchors.fill: parent
    image-source: images/background_market
    margin-top: 20
    margin-bottom: 20

  UIWidget
    id: downbox_store
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: background.bottom
    image-source: /images/newinterface/downbox_store
    margin-top: -5

  UIWidget
    id: topbox_store
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: background.top
    image-source: /images/newinterface/topbox_store
    margin-bottom: -5

  MarketClose
  BuyTabButton
  SellTabButton
  HistoricTabButton
  RequestsTabButton
  SearchText
  NewButton
    id: lupa
    anchors.verticalCenter: searchEdit.verticalCenter
    size: 32 32
    anchors.right: searchEdit.left
    margin-right: 5
    image-source: images/lupa
    @onClick: modules.game_market.getBuyItems()
  BuyPanel
  SellPanel
  HistoricPanel
  RequestsPanel
