HistoricLabel < UIWidget
  height: 25
  font: verdana-11px-antialised
  text-align: left
  margin-left: 10
  image-source: images/label_categorie
  margin-top: 5

BuyNowWindow < UIWidget
  id: buyNowWindow
  font: verdana-11px-antialised
  anchors.centerIn: parent
  size: 300 200
  visible: false
  image-source: images/background_popup
  @onEscape: show()
  opacity: 0.9

  Label
    id: buyItemName
    !text: tr("BUY ITEM")
    font: poppins semibold 22
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 15
    text-auto-resize: true

  Item
    id: item
    font: poppins semibold 11
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: buyItemName.bottom
    size: 48 48
    margin-top: 4
    margin-left: 4
    focusable: false
    virtual: true
    image-source: images/slot_item

  HorizontalScrollBar
    id: countScrollBar
    width: 160
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: item.bottom
    margin-left: 10
    margin-top: 15
    focusable: false

  UIWidget
    id: price
    font: poppins semibold 11
    height: 20
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: countScrollBar.bottom
    text-auto-resize: true
    margin-top: 7
    focusable: false
  NewButton
    id: buttonOk
    font: poppins boldbordered 16
    !text: tr('Confirm')
    size: 120 30
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: 20
    margin-right: 70
    focusable: false
    image-source: /images/newui/btngreen_large
  NewButton
    id: buttonCancel
    font: poppins boldbordered 16
    !text: tr('Cancel')
    size: 120 30
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: 20
    margin-left: 70
    focusable: false
    image-source: /images/newui/btnred_large

PageButton < Button
  size: 20 20
  font: lucida-11px-rounded
  anchors.verticalCenter: parent.verticalCenter
  anchors.left: parent.left
  @onClick: modules.game_market.togglePage(self:getId())
  $!first:
    anchors.left: prev.right
    margin-left: 2

PageWidget < UIWidget
  id: pageWidget
  font: verdana-11px-antialised
  size: 330 30
  anchors.bottom: parent.bottom
  margin-bottom: 50
  anchors.horizontalCenter: parent.horizontalCenter

  NewButton
    id: prev
    anchors.verticalCenter: pageIndex.verticalCenter
    anchors.right: pageIndex.left
    margin-right: 10
    size: 105 30
    !text: tr("PREV")
    font: sans-bold-16px
    text-align: center
    text-offset: 0 6
    @onClick: prevPage()
    image-source: /images/newui/btnblue_small
    @onClick: modules.game_market.togglePage(self:getId())

  UIWidget
    id: pageIndex
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    size: 100 30
    font: sans-bold-16px
    text-offset: 0 6
    text-align: center
    !text: tr("PAGE: 1/1")

  NewButton
    id: next
    anchors.verticalCenter: pageIndex.verticalCenter
    anchors.left: pageIndex.right
    margin-left: 10
    size: 105 30
    !text: tr("NEXT")
    text-offset: 0 6
    text-align: center
    font: sans-bold-16px
    @onClick: nextPage()
    image-source: /images/newui/btnblue_small
    @onClick: modules.game_market.togglePage(self:getId())

UIWidgetToMarketItem < UIItem
  height: 30
  font: lucida-11px-rounded
  anchors.top: parent.top
  anchors.left: parent.left
  virtual: true
  phantom: true

MarketSellItem < UIWidget
  height: 30
  font: lucida-11px-rounded
  margin-left: 50

  $!first:
    margin-top: 5

  UIWidget
    id: itemInfoBackground
    anchors.left: time.left
    anchors.right: timer.right
    image-source: images/label_categorie

  UIWidgetToMarketItem
    id: time
    font: lucida-11px-rounded
    margin-left: 10
    width: 40
  UIWidgetToMarketItem
    id: item
    font: lucida-11px-rounded
    width: 30
    anchors.left: prev.right
    phantom: false
  UIWidgetToMarketItem
    id: name
    font: lucida-11px-rounded
    width: 150
    anchors.left: prev.right
    text-align: center
  UIWidgetToMarketItem
    id: type
    font: lucida-11px-rounded
    width: 80
    anchors.left: prev.right
    text-align: center
  UIWidgetToMarketItem
    id: amount
    width: 70
    font: lucida-11px-rounded
    anchors.left: prev.right
  UIWidgetToMarketItem
    id: price
    font: lucida-11px-rounded
    width: 100
    anchors.left: prev.right
    text-align: center
    text-offset: 3 0
  UIWidgetToMarketItem
    id: timer
    font: lucida-11px-rounded
    width: 90
    anchors.left: prev.right
    text-align: center
    text-offset: 3 0
  NewButton
    id: cancel
    text: CANCEL
    size: 80 30
    anchors.left: timer.right
    margin-left: 10
    anchors.top: parent.top
    image-source: /images/newui/btnred_large
    @onClick: modules.game_market.cancelSellItem(self:getParent())

MarketItem < UIWidget
  height: 30
  font: lucida-11px-rounded

  $!first:
    margin-top: 5

  NewButton
    id: purchase
    text: PURCHASE
    size: 130 30
    anchors.left: parent.left
    margin-left: 10
    anchors.top: parent.top
    image-source: /images/newui/btngreen_large
    @onClick: modules.game_market.buyItem(self:getParent())

  UIWidget
    id: itemInfoBackground
    anchors.left: time.left
    anchors.right: timer.right
    image-source: images/label_categorie

  UIWidgetToMarketItem
    id: time
    font: lucida-11px-rounded
    anchors.left: purchase.right
    margin-left: 10
    width: 40
  UIWidgetToMarketItem
    id: item
    font: lucida-11px-rounded
    width: 30
    anchors.left: time.right
    phantom: false
  UIWidgetToMarketItem
    id: name
    font: lucida-11px-rounded
    width: 180
    anchors.left: item.right
    text-align: center
  UIWidgetToMarketItem
    id: seller
    font: lucida-11px-rounded
    width: 155
    anchors.left: name.right
  UIWidgetToMarketItem
    id: amount
    width: 70
    font: lucida-11px-rounded
    anchors.left: seller.right
  UIWidgetToMarketItem
    id: price
    font: lucida-11px-rounded
    width: 100
    anchors.left: amount.right
    text-align: center
    text-offset: 3 0
  UIWidgetToMarketItem
    id: timer
    font: lucida-11px-rounded
    width: 90
    anchors.left: price.right
    text-align: center
    text-offset: 3 0

MarketRequestItem < UIWidget
  height: 30
  font: lucida-11px-rounded
  margin-left: 50

  $!first:
    margin-top: 5

  UIWidget
    id: itemInfoBackground
