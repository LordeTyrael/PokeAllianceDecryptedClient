NewOpaqueWindow
  id: shop
  size: 300 306
  visible: false
  anchors.centerIn: parent
  focusable: true
  @onEscape: modules.game_store.closeConfirmWindow()

  PoppinsSemibold14
    id: title
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12
    color: #ffffff
    !text: tr("Buy Confirm")

  NewRedCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 8
    margin-right: 8
    @onClick: modules.game_store.closeConfirmWindow()

  Label
    id: name
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 15
    margin-right: 15
    height: 32
    font: poppins semibold 12
    color: #b6bcc4
    text-align: center
    text-wrap: true
    phantom: true

  UICreature
    id: outfit
    size: 48 48
    anchors.top: name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 30
    phantom: true
    visible: false
    scale: 2.0

  UIItem
    id: item
    size: 48 48
    anchors.top: name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 14
    phantom: true
    visible: false

  UIWidget
    id: animTabs
    height: 16
    anchors.bottom: priceLabel.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 6
    phantom: true
    layout:
      type: horizontalBox
      spacing: 4
      fit-children: true

  UIWidget
    id: priceLabel
    anchors.bottom: amountSpinner.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 8
    width: 100
    height: 26
    phantom: true
    layout:
      type: horizontalBox
      spacing: 5
      fit-children: true

    UIItem
      id: lcIcon
      size: 24 24
      item-id: 3028
      fixed-size: true
      phantom: true

    Label
      id: oldPrice
      font: poppins semibold 14
      color: #ff3b30
      text-auto-resize: true
      text-align: center
      visible: false
      phantom: true

      UIWidget
        id: oldPriceStrike
        height: 1
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        background-color: #ff3b30
        visible: false
        phantom: true

    Label
      id: price
      font: poppins semibold 14
      text-auto-resize: true
      text-align: center
      phantom: true

  AllianceAmountSpinner
    id: amountSpinner
    anchors.bottom: confirm.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 10

  NewStraightBlueButton
    id: confirm
    size: 90 30
    anchors.right: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-right: 6
    margin-bottom: 14
    focusable: false
    !text: tr("Confirm")
    @onClick: modules.game_store.buyItem(self)

  NewRedButton
    id: cancel
    size: 90 30
    anchors.left: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-bottom: 14
    focusable: false
    !text: tr("Cancel")
    @onClick: modules.game_store.closeConfirmWindow()
