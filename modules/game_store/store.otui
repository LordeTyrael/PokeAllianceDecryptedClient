StoreCategory < NewButton
  size: 194 33
  image-border: 15
  image-source: /images/modules/store_ui/category

  UIWidget
    id: category_icon
    size: 22 22
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    phantom: true

  Label
    id: category_name
    anchors.verticalCenter: category_icon.verticalCenter
    anchors.left: category_icon.right
    margin-left: 10

StoreAnimBar < Label
  size: 56 16
  image-source: /images/modules/progressbar_load_bg
  image-border-left: 10
  image-border-right: 10
  font: verdana-11px-rounded
  text-align: center
  color: #ffffff
  phantom: true

// Ícone TTF via icon-source (@família estilo tamanho codepoint) — f017 = relógio (FA solid)
StoreClockIcon < UIWidget
  size: 12 12
  icon-source: @fa solid 11 f017
  icon-color: #ffffff
  phantom: true


StoreWidget < ShopItemCard
  id: mainWidget

  UICreature
    id: outfit
    size: 80 80
    anchors.top: parent.top
    margin-top: 4
    anchors.horizontalCenter: parent.horizontalCenter
    margin-left: 15
    phantom: true
    visible: false
    new-scaling: true

  UIWidget
    id: label
    size: 51 51
    anchors.top: parent.top
    anchors.right: parent.right
    visible: false
    phantom: true

  UIWidget
    id: animLens
    size: 18 18
    anchors.bottom: name.top
    anchors.right: parent.right
    margin-right: 10
    margin-bottom: 2
    icon-source: @fa solid 15 f002
    icon-color: #ffffff
    visible: false

  Label
    id: promoTimeLeft
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 10
    margin-right: 10
    color: #ffffff
    text-auto-resize: true
    phantom: false
    visible: false

  StoreClockIcon
    id: clockIcon
    anchors.right: promoTimeLeft.left
    anchors.verticalCenter: promoTimeLeft.verticalCenter
    margin-right: 3

  &item:
    visible: false

  &priceIcon:
    item-id: 3028

  &name:
    anchors.top: outfit.bottom

DepositPanel < NewPopupWindow
  id: deposit_panel
  size: 380 172
  visible: false
  anchors.centerIn: parent
  @onEscape: modules.game_store.depositPanelClose()

  Label
    id: accountDiamonds
    anchors.top: parent.top
    margin-top: 8
    anchors.horizontalCenter: parent.horizontalCenter
    font: poppins semibold 14
    textColor: "#FFCA59"
    !text: tr("Available Diamonds on Character")
    margin-right: 3
    text-align: center
    text-auto-resize: true

  UIWidget
    id: diamondIcon
    size: 36 36
    virtual: true
    anchors.verticalCenter: points.verticalCenter
    anchors.right: points.left
    margin-right: 6
    image-source: newimages/icon_diamond

  // Fixed 90 (fits 1,234,567 at 78px) with the text centred inside it, not text-auto-resize:
  // a centred auto-resize widget grows to the right without the anchor running again, so the
  // pair walked off centre as the balance got longer. 21 is half the icon block (36 + 6),
  // which keeps icon+number centred as a unit at any width.
  UIWidget
    id: points
    size: 90 28
    text-align: center
    anchors.top: accountDiamonds.bottom
    font: poppins semibold 14
    margin-top: 10
    margin-left: 21
    anchors.horizontalCenter: parent.horizontalCenter
    !text: tr("0")

  NewRedCloseButton
    id: close
    size: 12 12
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 10
    margin-right: 10
    @onClick: modules.game_store.depositPanelClose()

  UIWidget
    margin-top: 70
    margin-right: 20
    margin-left: 20
    margin-bottom: 20
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    anchors.left: parent.left

    Label
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      font: poppins semibold 16
      textColor: "#ffca70"
      !text: tr("Quantity")
      text-align: center

    // 32 is label_search's own height and image-border keeps its corners at any width
    TextEdit
      id: count
      size: 200 32
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: prev.bottom
      margin-top: 10
      image-source: newimages/label_search
      image-border: 10
      text-align: center

    NewButton
      id: button
      !text: tr('Confirm')
      size: 100 30
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      image-source: /images/newui/btngreen_small
      @onClick: modules.game_store.sendDepositRequest()

WithdrawPanel < NewPopupWindow
  id: withdraw_panel
  size: 380 172
  visible: false
  anchors.centerIn: parent
  @onEscape: modules.game_store.withdrawPanelClose()

  Label
    id: accountDiamonds
    anchors.top: parent.top
    margin-top: 8
    anchors.horizontalCenter: parent.horizontalCenter
    font: poppins semibold 14
    textColor: "#FFCA59"
    !text: tr("Available Diamonds on Account")
    text-align: center
    text-auto-resize: true

  UIWidget
    id: diamondIcon
    size: 36 36
    virtual: true
    anchors.verticalCenter: points.verticalCenter
    anchors.right: points.left
    margin-right: 6
    image-source: newimages/icon_diamond

  // Fixed 90 (fits 1,234,567 at 78px) with the text centred inside it, not text-auto-resize:
  // a centred auto-resize widget grows to the right without the anchor running again, so the
  // pair walked off centre as the balance got longer. 21 is half the icon block (36 + 6),
  // which keeps icon+number centred as a unit at any width.
