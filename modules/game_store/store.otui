  NewRedCloseButton
    id: close
    size: 12 12
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 10
    margin-right: 10
    @onClick: modules.game_store.withdrawPanelClose()

  UIWidget
    margin-top: 70
    margin-right: 20
    margin-left: 20
    margin-bottom: 20
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    anchors.left: parent.left

    Label
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      font: poppins semibold 16
      textColor: "#ffca70"
      !text: tr("Quantity")
      text-align: center

    // 32 is label_search's own height and image-border keeps its corners at any width
