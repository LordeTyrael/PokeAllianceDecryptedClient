MeritEntry < Panel
  height: 50
  margin-top: 2
  focusable: false

  UIItem
    id: itemIcon
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    virtual: true
    phantom: false

  Label
    id: itemName
    anchors.left: prev.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 4
    text-auto-resize: true
    font: poppins semibold 13
    color: #e8e8e8
    phantom: true

  UIWidget
    id: progressBarBackground
    anchors.left: itemIcon.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 12
    margin-bottom: 6
    height: 16
    image-source: /images/modules/progressbar_background
    image-smooth: true
    phantom: true

    UIWidget
      id: progressBarFill
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 0
      image-source: /images/modules/progressbar_fill
      image-smooth: true
      phantom: true

    Label
      id: countLabel
      anchors.centerIn: parent
      text-auto-resize: true
      font: poppins bold 11
      color: #ffffff
      phantom: true
      text-offset: 0 1

NewOpaqueWindow
  @onEscape: modules.game_ruinedascendant.hideMeritWindow()
  id: meritWindow
  anchors.centerIn: parent
  size: 380 460
  focusable: true

  UIWidget
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    size: 280 37
    image-offset: 1 0
    image-source: images/header
    font: poppins bold 20
    text-align: left
    text-offset: 10 0
    !text: tr("Merit")

  NewRedCloseButton
    id: meritClose
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 10 10 0 0
    @onClick: modules.game_ruinedascendant.hideMeritWindow()

  ScrollablePanel
    id: meritScroll
    anchors.top: header.bottom
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: meritScrollBar.left
    margin-top: 15
    margin-bottom: 15
    margin-left: 15
    margin-right: 5
    padding: 4
    vertical-scrollbar: meritScrollBar
    layout:
      type: verticalBox
      spacing: 2

  AllianceVerticalScrollBar
    id: meritScrollBar
    anchors.top: header.bottom
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 15
    margin-bottom: 15
    margin-right: 10
    pixels-scroll: true
    step: 40

  Label
    id: emptyLabel
    anchors.centerIn: parent
    anchors.top: header.bottom
    margin-top: 60
    text-align: center
    text-auto-resize: true
    font: poppins regular 14
    color: #76869a
    !text: tr("No merit data yet.")
    visible: false
