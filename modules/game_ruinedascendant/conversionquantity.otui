NewOpaqueWindow
  id: conversionQuantityWindow
  size: 340 208
  anchors.centerIn: parent
  visible: false
  focusable: true
  @onEscape: modules.game_ruinedascendant.closeQuantityWindow()

  PoppinsSemibold14
    id: quantityTitle
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12
    color: #ffffff
    !text: tr("Convert Quantity")

  UIItem
    id: quantitySourceItem
    size: 32 32
    anchors.top: quantityTitle.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 14
    margin-left: -60
    phantom: true
    virtual: true

  Label
    id: quantityArrow
    anchors.verticalCenter: prev.verticalCenter
    anchors.horizontalCenter: parent.horizontalCenter
    font: poppins bold 18
    color: #ffffff
    text: ->
    text-auto-resize: true

  UIItem
    id: quantityTargetItem
    size: 32 32
    anchors.top: quantitySourceItem.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-left: 60
    phantom: true
    virtual: true

  AllianceAmountSpinner
    id: quantitySpinner
    anchors.top: quantitySourceItem.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 14

  PoppinsSemibold12
    id: quantityCostLabel
    anchors.top: quantitySpinner.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    color: #ffffff
    !text: tr("Cost: $0")

  NewStraightBlueButton
    id: quantityConfirmButton
    size: 90 30
    anchors.right: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-right: 6
    margin-bottom: 14
    !text: tr("Confirm")

  NewRedButton
    id: cancelButton
    size: 90 30
    anchors.left: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-bottom: 14
    !text: tr("Cancel")
    @onClick: modules.game_ruinedascendant.closeQuantityWindow()

  NewRedCloseButton
    id: quantityCloseBtn
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 8
    margin-right: 8
    @onClick: modules.game_ruinedascendant.closeQuantityWindow()
